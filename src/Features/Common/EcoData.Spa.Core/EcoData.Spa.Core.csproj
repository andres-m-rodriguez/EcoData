<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- The shared kernel every SPA feature library sits on: the event bus and
       the registration entry point. No MudBlazor, no Razor SDK, no Blazor
       component model — a feature library brings whatever it needs itself. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" />
    <PackageReference Include="Tempest.Abstract" Version="1.0.0-beta.8" />
  </ItemGroup>

</Project>
