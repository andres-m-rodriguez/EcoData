<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Services and contracts only: no MudBlazor and no Razor SDK, so a host can
       have navigation without inheriting a design system. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.4" />
    <PackageReference Include="Microsoft.JSInterop" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EcoData.Spa.Core\EcoData.Spa.Core.csproj" />
  </ItemGroup>

</Project>
