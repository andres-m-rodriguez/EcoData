@namespace EcoData.Ui.Shell

<div class="@ShellClass">
    <MudLayout>
        <MudAppBar Elevation="0" Fixed="true" Class="ui-appbar">
            @AppBar
        </MudAppBar>

        <MudMainContent Class="ui-main">
            <div class="ui-shell-body">
                @if (Rail is not null)
                {
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <aside class="@RailClass" aria-hidden="@(RailOpen ? "false" : "true")">
                            @Rail
                        </aside>
                    </MudHidden>
                }
                <div class="ui-main-panel">
                    @ChildContent
                </div>
            </div>
        </MudMainContent>
    </MudLayout>

    @if (BottomNav is not null)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            @BottomNav
        </MudHidden>
    }
</div>

@code {
    [Parameter]
    public RenderFragment? AppBar { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? BottomNav { get; set; }

    // A desktop companion column beside the page, in its own panel.
    [Parameter]
    public RenderFragment? Rail { get; set; }

    [Parameter]
    public bool RailOpen { get; set; } = true;

    // A page that sizes itself to the viewport (a map) gets the ground with no
    // panel around it, and only the floating bar over it.
    [Parameter]
    public bool Bleed { get; set; }

    private string ShellClass =>
        "ui-shell" + (Bleed ? " is-bleed" : "") + (Rail is not null && RailOpen ? " has-rail-open" : "");

    private string RailClass => RailOpen ? "ui-rail-panel" : "ui-rail-panel is-collapsed";
}
