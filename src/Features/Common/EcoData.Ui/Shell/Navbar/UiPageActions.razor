@namespace EcoData.Ui.Shell.Navbar
@inherits StatefulComponent
@inject INavbarManager Navbar

@if (Navbar.State.Actions.Count == 1)
{
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Small"
               Class="ui-page-action"
               OnClick="@(() => Navbar.State.Actions[0].OnClick())">
        @Navbar.State.Actions[0].Title
    </MudButton>
}
else if (Navbar.State.Actions.Count > 1)
{
    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
             AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight"
             AriaLabel="Page actions">
        @foreach (var action in Navbar.State.Actions)
        {
            <MudMenuItem OnClick="@(() => action.OnClick())">@action.Title</MudMenuItem>
        }
    </MudMenu>
}

@code {
    [Event]
    private void OnNavbarChanged(NavbarChanged _) { }
}
