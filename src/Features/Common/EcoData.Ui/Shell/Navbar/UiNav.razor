@namespace EcoData.Ui.Shell.Navbar
@inherits StatefulComponent
@inject NavigationManager Navigation

<nav class="ui-nav">
    @foreach (var link in Links)
    {
        <a href="@link.Href" class="@(link.IsActive(new Uri(Navigation.Uri).AbsolutePath) ? "ui-nav-link is-active" : "ui-nav-link")">
            @link.Label
        </a>
    }
</nav>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<UiNavLink> Links { get; set; }

    [Event]
    private void OnNavigationChanged(NavigationChanged _) { }
}
