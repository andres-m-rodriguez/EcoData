@namespace EcoData.Ui.Workspace

<div class="ui-section-head">
    <div class="ui-section-text">
        @if (Eyebrow is not null)
        {
            <div class="ui-section-eyebrow">@Eyebrow</div>
        }
        <h2 class="ui-section-title">@Title</h2>
        @if (Subtitle is not null)
        {
            <p class="ui-section-sub">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="ui-section-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
