@namespace EcoData.Spa.Map
@typeparam TMarker where TMarker : IMapMarker
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_mapElement" class="@GetContainerClass()" style="@GetContainerStyle()"></div>

@code {
    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _mapInstance;
    private DotNetObjectReference<SpaMap<TMarker>>? _dotNetRef;
    private bool _isInitialized;

    [Parameter, EditorRequired]
    public required IMapController<TMarker> Controller { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string Height { get; set; } = "400px";

    [Parameter]
    public string Width { get; set; } = "100%";

    protected override void OnInitialized()
    {
        Controller.OnMarkersChanged += HandleMarkersChanged;
        Controller.OnViewChanged += HandleViewChanged;
        Controller.OnGeoJsonChanged += HandleGeoJsonChanged;
        Controller.OnCirclesChanged += HandleCirclesChanged;
        Controller.OnCircleFocusRequested += HandleCircleFocusRequested;
        Controller.OnSearchRadiusChanged += HandleSearchRadiusChanged;
        Controller.OnPolygonDrawActionRequested += HandlePolygonDrawActionRequested;
        Controller.OnHeatmapChanged += HandleHeatmapChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/EcoData.Spa.Map/spamap.js");

            _mapInstance = await _module.InvokeAsync<IJSObjectReference>(
                "initialize",
                _mapElement,
                Controller.Center.Latitude,
                Controller.Center.Longitude,
                Controller.Zoom,
                _dotNetRef);

            if (Controller is MapController<TMarker> mapController)
            {
                mapController.GeolocationProvider = GetCurrentPositionAsync;
            }

            _isInitialized = true;
            await UpdateMarkers();
            await UpdateGeoJson();
            await UpdateCircles();
        }
    }

    // ===== JS Callbacks =====

    [JSInvokable]
    public void OnMarkerClickedFromJs(int index)
    {
        Controller.RaiseMarkerClicked(index);
    }

    [JSInvokable]
    public void OnMapClickedFromJs(double lat, double lng)
    {
        Controller.RaiseMapClicked(new MapCoordinate(lat, lng));
    }

    [JSInvokable]
    public void OnGeoJsonClickedFromJs(string layerId, string? properties)
    {
        Controller.RaiseGeoJsonClicked(layerId, properties);
    }

    [JSInvokable]
    public void OnGeoJsonLoadedFromJs(string layerId, bool success)
    {
        Controller.RaiseGeoJsonLoaded(layerId, success);
    }

    [JSInvokable]
    public void OnCircleClickedFromJs(int index)
    {
        Controller.RaiseCircleClicked(index);
    }

    [JSInvokable]
    public void OnPolygonDrawnFromJs(MapCoordinate[] coordinates)
    {
        Controller.RaisePolygonDrawn(coordinates);
    }

    [JSInvokable]
    public void OnPolygonDrawCancelledFromJs()
    {
        Controller.RaisePolygonDrawCancelled();
    }

    // ===== Event Handlers =====

    private async void HandleMarkersChanged()
    {
        if (_isInitialized)
        {
            await InvokeAsync(async () => await UpdateMarkers());
        }
    }

    private async void HandleViewChanged()
    {
        if (_isInitialized && _mapInstance is not null && _module is not null)
        {
            await InvokeAsync(async () =>
            {
                await _module.InvokeVoidAsync(
                    "setView",
                    _mapInstance,
                    Controller.Center.Latitude,
                    Controller.Center.Longitude,
                    Controller.Zoom);
            });
        }
    }

    private async void HandleGeoJsonChanged()
    {
        if (_isInitialized)
        {
            await InvokeAsync(async () => await UpdateGeoJson());
        }
    }

    private async void HandleCirclesChanged()
    {
        if (_isInitialized)
        {
            await InvokeAsync(async () => await UpdateCircles());
        }
    }

    private async void HandleCircleFocusRequested(int? index)
    {
        if (!_isInitialized || _mapInstance is null || _module is null) return;

        await InvokeAsync(async () =>
        {
            if (index is { } i)
            {
                await _module.InvokeVoidAsync("focusCircle", _mapInstance, i);
            }
            else
            {
                await _module.InvokeVoidAsync("focusAllCircles", _mapInstance);
            }
        });
    }

    private async void HandleSearchRadiusChanged((MapCoordinate Center, double RadiusMeters)? radius)
    {
        if (!_isInitialized || _mapInstance is null || _module is null) return;

        await InvokeAsync(async () =>
        {
            if (radius is { } r)
            {
                await _module.InvokeVoidAsync(
                    "showSearchRadius",
                    _mapInstance,
                    r.Center.Latitude,
                    r.Center.Longitude,
                    r.RadiusMeters);
            }
            else
            {
                await _module.InvokeVoidAsync("clearSearchRadius", _mapInstance);
            }
        });
    }

    private async void HandlePolygonDrawActionRequested(MapPolygonDrawAction action)
    {
        if (!_isInitialized || _mapInstance is null || _module is null) return;

        await InvokeAsync(async () =>
        {
            var function = action switch
            {
                MapPolygonDrawAction.Enable => "enablePolygonDraw",
                MapPolygonDrawAction.Finish => "finishPolygonDraw",
                MapPolygonDrawAction.Cancel => "cancelPolygonDraw",
                _ => "clearDrawnPolygon",
            };
            await _module.InvokeVoidAsync(function, _mapInstance);
        });
    }

    private async void HandleHeatmapChanged()
    {
        if (!_isInitialized || _mapInstance is null || _module is null) return;
        if (Controller is not MapController<TMarker> mapController) return;

        await InvokeAsync(async () =>
        {
            if (!mapController.HeatmapVisible)
            {
                await _module.InvokeVoidAsync("hideHeatmap", _mapInstance);
                return;
            }

            var points = mapController.HeatPoints.Select(p => new
            {
                latitude = p.Latitude,
                longitude = p.Longitude,
                intensity = p.Intensity,
                isFauna = p.IsFauna
            }).ToArray();

            await _module.InvokeVoidAsync(
                "showHeatmap",
                _mapInstance,
                points,
                mapController.HeatmapFilter.ToString().ToLowerInvariant());
        });
    }

    private async Task<MapGeolocationResult?> GetCurrentPositionAsync()
    {
        if (_module is null) return null;

        return await _module.InvokeAsync<MapGeolocationResult>("getCurrentPosition");
    }

    // ===== Update Methods =====

    private async Task UpdateMarkers()
    {
        if (_mapInstance is null || _module is null) return;

        var markerData = Controller.Markers.Select((m, i) => new
        {
            index = i,
            lat = m.Coordinate.Latitude,
            lng = m.Coordinate.Longitude,
            popup = m.PopupContent,
            tooltip = m.TooltipContent
        }).ToArray();

        await _module.InvokeVoidAsync("setMarkers", _mapInstance, markerData);
    }

    private async Task UpdateCircles()
    {
        if (_mapInstance is null || _module is null) return;

        var circleData = Controller.Circles.Select((c, i) => new
        {
            index = i,
            lat = c.Center.Latitude,
            lng = c.Center.Longitude,
            radiusMeters = c.RadiusMeters,
            fillColor = c.FillColor,
            strokeColor = c.StrokeColor,
            popup = c.PopupHtml
        }).ToArray();

        await _module.InvokeVoidAsync("setCircles", _mapInstance, circleData);
    }

    private async Task UpdateGeoJson()
    {
        if (_mapInstance is null || _module is null) return;

        if (Controller is MapController<TMarker> mapController)
        {
            var geoJsonLayers = mapController.GetGeoJsonLayers().Select(g => new
            {
                id = g.Id,
                data = g.Data,
                url = g.Url,
                cacheKey = g.CacheKey,
                cacheVersion = g.CacheVersion,
                fillColor = g.FillColor,
                fillOpacity = g.FillOpacity,
                strokeColor = g.StrokeColor,
                strokeWidth = g.StrokeWidth
            }).ToArray();

            await _module.InvokeVoidAsync("setGeoJson", _mapInstance, geoJsonLayers);
        }
    }

    // ===== Helpers =====

    private string GetContainerClass()
    {
        var classes = new List<string> { "spa-map" };
        if (!string.IsNullOrEmpty(Class))
            classes.Add(Class);
        return string.Join(" ", classes);
    }

    private string GetContainerStyle()
    {
        var style = $"height: {Height}; width: {Width};";
        if (!string.IsNullOrEmpty(Style))
            style += $" {Style}";
        return style;
    }

    public async ValueTask DisposeAsync()
    {
        Controller.OnMarkersChanged -= HandleMarkersChanged;
        Controller.OnViewChanged -= HandleViewChanged;
        Controller.OnGeoJsonChanged -= HandleGeoJsonChanged;
        Controller.OnCirclesChanged -= HandleCirclesChanged;
        Controller.OnCircleFocusRequested -= HandleCircleFocusRequested;
        Controller.OnSearchRadiusChanged -= HandleSearchRadiusChanged;
        Controller.OnPolygonDrawActionRequested -= HandlePolygonDrawActionRequested;
        Controller.OnHeatmapChanged -= HandleHeatmapChanged;

        if (Controller is MapController<TMarker> mapController)
        {
            mapController.GeolocationProvider = null;
        }

        if (_mapInstance is not null)
        {
            try
            {
                if (_module is not null)
                {
                    await _module.InvokeVoidAsync("dispose", _mapInstance);
                }
            }
            catch (JSDisconnectedException)
            {
                // Ignore during disconnect
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Ignore during disconnect
            }
        }

        _dotNetRef?.Dispose();
    }
}
