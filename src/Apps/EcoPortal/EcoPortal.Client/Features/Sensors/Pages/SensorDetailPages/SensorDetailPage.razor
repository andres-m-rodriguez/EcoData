@page "/sensor/{SensorId:guid}"
@using EcoData.Sensors.Contracts.Dtos
@using EcoData.Sensors.Application.Client
@using EcoPortal.Client.Components
@using EcoPortal.Client.Features.Sensors.Pages.SensorDetailPages.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject ISensorHttpClient SensorClient

<PageTitle>Sensor Details - EcoData</PageTitle>

<NuiPageLayout Title="Sensor Details" ParentPath="/sensor-dashboard">
        @if (_loading)
        {
            <SensorDetailSkeleton />
        }
        else if (_sensor is null)
        {
            @if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
            }
            else
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SensorsOff" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Sensor not found</MudText>
                </MudStack>
            }
        }
        else
        {
            <AuthorizeView>
                <Authorized>
                    <SensorDetailAuthenticated Sensor="_sensor" />
                </Authorized>
                <NotAuthorized>
                    <SensorDetailAnonymous Sensor="_sensor" />
                </NotAuthorized>
            </AuthorizeView>
        }
</NuiPageLayout>

@code {
    private SensorDtoForDetail? _sensor;
    private string? _loadError;
    private bool _loading = true;

    [Parameter]
    public Guid SensorId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await SensorClient.GetByIdAsync(SensorId);
        if (!result.TryPickT0(out var sensor, out var sensorError))
        {
            _sensor = null;
            _loadError = sensorError.StatusCode switch
            {
                404 => null,
                0 => "Couldn't reach the server.",
                _ => sensorError.Message ?? "Couldn't load this sensor."
            };
            _loading = false;
            return;
        }

        _sensor = sensor;
        _loading = false;
    }
}