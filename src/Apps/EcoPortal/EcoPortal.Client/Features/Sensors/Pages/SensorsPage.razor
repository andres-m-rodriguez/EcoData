@page "/sensor-dashboard"
@using EcoData.Common.Problems.Contracts
@using EcoData.Sensors.Application.Client
@using EcoData.Sensors.Contracts.Dtos
@using EcoData.Sensors.Contracts.Parameters
@using EcoPortal.Client.Features.Sensors.Components
@inherits StatefulComponent
@inject NavigationManager Navigation
@inject ISensorHttpClient SensorClient
@inject ISensorReadingHttpClient ReadingClient

<PageTitle>Sensors - EcoData</PageTitle>

<div class="sensors-page">

    <section class="hero">
        <div class="hero-in">
            <div>
                <div class="hero-eyebrow"><span class="v-line"></span>Live Network · Puerto Rico</div>
                <h1>Every sensor, <em>visible</em>.</h1>
                <p>
                    Real-time and recent readings from every monitoring station registered to the EcoData network —
                    USGS Caribbean stations, partner organizations, and individual researchers. Browse by status,
                    organization, or municipality.
                </p>
            </div>

            <aside class="hero-stats">
                @if (_loadError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_loadError</MudAlert>
                }
                <div class="hero-stats-k"><span class="pulse"></span>Updated · just now</div>
                <div class="hs-item">
                    <span class="hs-label">Total sensors</span>
                    @if (LoadTotalSensorsState.IsLoading)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="32px" />
                    }
                    else
                    {
                        <span class="hs-val">@LoadTotalSensorsState.Result.ToString("N0")</span>
                    }
                </div>
                <div class="hs-item">
                    <span class="hs-label">Active sensors</span>
                    @if (LoadActiveSensorsState.IsLoading || LoadTotalSensorsState.IsLoading)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="32px" />
                    }
                    else
                    {
                        <span class="hs-val">@LoadActiveSensorsState.Result.ToString("N0")<span class="u">/@LoadTotalSensorsState.Result.ToString("N0")</span></span>
                    }
                </div>
                <div class="hs-item">
                    <span class="hs-label">Total readings</span>
                    @if (LoadTotalReadingsState.IsLoading)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="32px" />
                    }
                    else
                    {
                        <span class="hs-val">@LoadTotalReadingsState.Result.ToString("N0")</span>
                    }
                </div>
                <div class="hs-item"><span class="hs-label">Updated every</span><span class="hs-val">15<span class="u">min</span></span></div>
            </aside>
        </div>
    </section>

    <main class="body-in">

        <div class="section-h">
            <div class="section-h-l">
                <div class="eyebrow">Browse stations</div>
                <h2>Find a <em>station</em></h2>
                <p>Search by river, municipality, or station ID. Click any sensor to drill into its live readings, recent history, and configuration.</p>
            </div>
        </div>

        <div class="list-card">
            <SensorList OnSensorClick="NavigateToDetail" />
        </div>

    </main>
</div>

@code {
    private string? _loadError;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Bus.Publish(new MainLayout.TitleChanged("Sensors"));
    }

    [Command, RunOnLoad]
    private async Task<int> LoadTotalSensors(CancellationToken ct)
    {
        var result = await SensorClient.GetSensorCountAsync(new SensorParameters(), ct);
        if (!result.TryPickT0(out var count, out var error))
        {
            SetLoadError(error, "Couldn't load total sensor count.");
            return 0;
        }
        return count;
    }

    [Command, RunOnLoad]
    private async Task<int> LoadActiveSensors(CancellationToken ct)
    {
        var result = await SensorClient.GetSensorCountAsync(new SensorParameters(IsActive: true), ct);
        if (!result.TryPickT0(out var count, out var error))
        {
            SetLoadError(error, "Couldn't load active sensor count.");
            return 0;
        }
        return count;
    }

    [Command, RunOnLoad]
    private async Task<long> LoadTotalReadings(CancellationToken ct)
    {
        var result = await ReadingClient.GetTotalCountAsync(ct);
        if (!result.TryPickT0(out var count, out var error))
        {
            SetLoadError(error, "Couldn't load reading count.");
            return 0;
        }
        return count;
    }

    private void SetLoadError(RequestFailed error, string fallback)
    {
        _loadError = error.StatusCode == 0
            ? "Couldn't reach the server. Check your connection."
            : error.Message ?? fallback;
    }

    private void NavigateToDetail(SensorDtoForList sensor)
    {
        Navigation.NavigateTo($"/sensor/{sensor.Id}");
    }
}
