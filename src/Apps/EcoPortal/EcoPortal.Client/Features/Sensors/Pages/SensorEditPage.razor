@page "/sensor/{SensorId:guid}/edit"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using EcoData.Sensors.Application.Client
@using EcoData.Sensors.Contracts.Dtos
@using EcoPortal.Client.Features.Sensors.Components
@using EcoPortal.Client.Services
@using EcoPortal.Client.Components
@using BlazingSingularity.Commands
@using static EcoPortal.Client.Features.Sensors.Components.SensorForm
@using SensorPermissions = EcoData.Sensors.Contracts.Permissions
@inject ISensorHttpClient SensorClient
@inject INativeNavigationManager Navigation
@inject ISnackbar Snackbar
@inject PermissionContextService PermissionContext
@inject AuthStateService AuthState

<PageTitle>Edit Sensor - EcoData</PageTitle>

<NuiPageLayout Title="Edit Sensor" ParentPath="@($"/sensor/{SensorId}")">
        @if (LoadCommand.IsLoading)
        {
            <MudPaper Elevation="1" Class="pa-6">
                <MudSkeleton Width="200px" Height="32px" />
                <MudSkeleton Width="100%" Height="56px" Class="mt-4" />
                <MudSkeleton Width="100%" Height="56px" Class="mt-4" />
                <MudSkeleton Width="100%" Height="56px" Class="mt-4" />
            </MudPaper>
        }
        else if (_sensor is null || !_hasPermission)
        {
            <MudPaper Elevation="1" Class="pa-6">
                @if (_loadError is not null)
                {
                    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
                }
                else
                {
                    <MudStack AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
                        <MudText Typo="Typo.h6" Color="Color.Error" Class="mt-2">
                            @(_sensor is null ? "Sensor not found" : "You don't have permission to edit this sensor")
                        </MudText>
                    </MudStack>
                }
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="1" Class="pa-6">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    External ID: <strong>@_sensor.ExternalId</strong>
                </MudText>

                <SensorForm Model="_formModel"
                            SubmitButtonText="Save Changes"
                            ErrorMessage="@_errorMessage"
                            IsLoading="SaveCommand.IsLoading"
                            HideExternalId="true"
                            OnSubmit="HandleSubmit"
                            OnCancel="NavigateBack" />
            </MudPaper>
        }
</NuiPageLayout>

@code {
    [Parameter]
    public Guid SensorId { get; set; }

    private SensorDtoForDetail? _sensor;
    private SensorFormModel _formModel = new();
    private string? _errorMessage;
    private string? _loadError;
    private bool _hasPermission;

    protected override async Task OnInitializedAsync()
    {
        await LoadCommand.ExecuteAsync();
    }

    [RelayCommand]
    private async Task Load()
    {
        var sensorResult = await SensorClient.GetByIdAsync(SensorId);
        if (!sensorResult.TryPickT0(out var sensor, out var sensorError))
        {
            _sensor = null;
            _loadError = sensorError.StatusCode switch
            {
                404 => null,
                0 => "Couldn't reach the server.",
                _ => sensorError.Message ?? "Couldn't load this sensor."
            };
            return;
        }

        _sensor = sensor;

        if (!AuthState.IsInitialized)
        {
            await AuthState.InitializeAsync();
        }

        _hasPermission = AuthState.IsGlobalAdmin ||
            await PermissionContext.HasPermissionAsync(_sensor.OrganizationId, SensorPermissions.Sensor.Update);

        if (!_hasPermission)
        {
            return;
        }

        _formModel = new SensorFormModel
        {
            ExternalId = _sensor.ExternalId,
            Name = _sensor.Name,
            Latitude = _sensor.Latitude,
            Longitude = _sensor.Longitude,
            MunicipalityId = _sensor.MunicipalityId,
            IsActive = _sensor.IsActive
        };
    }

    private async Task HandleSubmit(SensorFormModel model)
    {
        await SaveCommand.ExecuteAsync();
    }

    [RelayCommand]
    private async Task Save()
    {
        _errorMessage = null;

        var request = new SensorDtoForUpdate(
            _sensor!.ExternalId,
            _formModel.Name.Trim(),
            _formModel.Latitude,
            _formModel.Longitude,
            _formModel.MunicipalityId,
            _formModel.IsActive
        );

        var result = await SensorClient.UpdateAsync(SensorId, request);

        result.Switch(
            _ =>
            {
                Snackbar.Add("Sensor updated successfully", Severity.Success);
                Navigation.NavigateTo($"/sensor/{SensorId}", replace: true);
            },
            validationFailed => _errorMessage = string.Join(" ", validationFailed.AllMessages),
            requestFailed => _errorMessage = requestFailed.Message ?? "Failed to update sensor"
        );
    }

    private void NavigateBack() => _ = Navigation.GoBackAsync();
}
