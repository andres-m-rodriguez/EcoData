@page "/organizations/{OrganizationId:guid}/sensors"
@using EcoData.Sensors.Contracts
@using EcoPortal.Client.Authorization
@attribute [OrganizationPermission(Permissions.Sensor.Read)]
@using EcoData.Sensors.Contracts.Dtos
@using EcoPortal.Client.Features.Sensors.Components
@using EcoPortal.Client.Features.Organizations.Workspace
@inject INavigationManager Navigation

<OrganizationWorkspace OrganizationId="OrganizationId" Section="OrganizationSection.Sensors">
    <UiSectionHead Title="Sensors" Eyebrow="Stations">
        <Actions>
            @if (context.Can(Permissions.Sensor.Create))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                           Href="@($"/organizations/{OrganizationId}/sensors/create")">
                    Add sensor
                </MudButton>
            }
        </Actions>
    </UiSectionHead>

    <SensorList OrganizationId="OrganizationId" Elevation="0"
                EmptyMessage="No sensors yet"
                EmptySubMessage="Add sensors to start monitoring water quality."
                OnSensorClick="NavigateToDetail" />
</OrganizationWorkspace>

@code {
    [Parameter]
    public Guid OrganizationId { get; set; }

    private void NavigateToDetail(SensorDtoForList sensor) => Navigation.NavigateTo($"/sensor/{sensor.Id}");
}
