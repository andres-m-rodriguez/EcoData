@page "/organizations/{Id:guid}"
@using EcoData.Organization.Contracts.Dtos
@using EcoData.Organization.Contracts.Parameters
@using EcoData.Organization.Application.Client
@using EcoData.Sensors.Contracts.Dtos
@using EcoData.Sensors.Contracts.Parameters
@using EcoData.Sensors.Application.Client
@using EcoPortal.Client.Features.Organizations.Services
@using EcoPortal.Client.Services
@using EcoPortal.Client.Components
@using EcoPortal.Client.Features.Organizations.Authorization
@using EcoPortal.Client.Features.Sensors.Components
@using EcoPortal.Client.Features.Organizations.Components
@using EcoPortal.Client.Features.OrganizationAccessRequests.Dialogs
@inherits StatefulComponent
@using OrgPermissions = EcoData.Organization.Contracts.Permissions
@using SensorPermissions = EcoData.Sensors.Contracts.Permissions
@inject IOrganizationHttpClient OrganizationClient
@inject AuthStateService AuthState
@inject ISensorHttpClient SensorClient
@inject IOrganizationMemberHttpClient MemberClient
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IOrganizationCacheService OrganizationCache

<PageTitle>Organization Details - EcoData</PageTitle>

<PageShell Title="Organization Details" ParentPath="/organizations/discover">
    <div class="org-page page-enter" style="@ThemeStyle">
        @if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
        }
        @if (_organization is null && LoadOrganizationState.IsLoading)
        {
            <MudPaper Elevation="0" Class="org-hero-skeleton pa-6 rounded-lg mb-6">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="4">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="72px" Height="72px" />
                    <MudStack Spacing="2">
                        <MudSkeleton Width="320px" Height="40px" />
                        <MudSkeleton Width="220px" Height="20px" />
                    </MudStack>
                </MudStack>
            </MudPaper>
            <MudPaper Elevation="0" Class="rounded-lg pa-6">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Class="mb-4" />
                <MudGrid Spacing="4">
                    @for (var i = 0; i < 3; i++)
                    {
                        <MudItem xs="12" sm="4">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        }
        else if (LoadOrganizationState.Result is null && !LoadOrganizationState.IsLoading && _loadError is null)
        {
            <MudPaper Elevation="0" Class="pa-8 rounded-lg d-flex flex-column align-center justify-center org-not-found">
                <MudIcon Icon="@Icons.Material.Filled.DomainDisabled" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                <MudText Typo="Typo.h5" Color="Color.Error">Organization not found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 text-center">
                    The organization you are looking for does not exist or you do not have permission to view it.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6"
                           OnClick="@(() => Navigation.NavigateTo("/organizations"))">
                    Back to Organizations
                </MudButton>
            </MudPaper>
        }
        else if (_organization is { } org)
        {

            @* ============================ HERO ============================ *@
            <section class="org-hero @(HasText(org.CardPictureUrl) ? "has-banner" : "no-banner")"
                     style="@(HasText(org.CardPictureUrl) ? $"background-image: linear-gradient(180deg, rgba(20,28,24,0.55) 0%, rgba(20,28,24,0.85) 100%), url('{org.CardPictureUrl}');" : null)">
                <div class="org-hero-grid">
                    <div class="org-hero-left">
                        <div class="org-hero-eyebrow">
                            <span class="v-line"></span>
                            <MudText Inline="true" Style="color: white;">@org.Slug</MudText>
                            @if (HasText(org.Location))
                            {
                                <MudText Inline="true" Class="dot-sep">·</MudText>
                                <MudText Inline="true" Style="color: white;">@org.Location</MudText>
                            }
                        </div>

                        <div class="org-hero-orgline">
                            @if (HasText(org.ProfilePictureUrl))
                            {
                                <div class="hero-mark hero-mark-img">
                                    <MudImage Src="@org.ProfilePictureUrl" Alt="@org.Name" ObjectFit="ObjectFit.Cover" />
                                </div>
                            }
                            else
                            {
                                <div class="hero-mark">@GetInitials(org.Name)</div>
                            }
                            <div>
                                <div class="org-hero-orgmeta"><strong>@org.Name</strong></div>
                                <div class="org-hero-orgmeta">
                                    Org · joined @org.CreatedAt.ToString("MMM d, yyyy")
                                    @if (org.FoundedYear.HasValue)
                                    {
                                        <span> · active since @org.FoundedYear</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <h1 class="org-hero-title">@org.Name</h1>

                        @if (HasText(org.Tagline))
                        {
                            <p class="org-hero-tagline">@org.Tagline</p>
                        }

                        <div class="org-hero-meta-row">
                            @if (HasText(org.WebsiteUrl))
                            {
                                <span class="hmr-item">
                                    <MudIcon Icon="@Icons.Material.Outlined.Link" Size="Size.Small" Style="color: white !important;" />
                                    <MudLink Href="@org.WebsiteUrl" Target="_blank" Style="color: white;">@GetDisplayWebsiteUrl(org.WebsiteUrl)</MudLink>
                                </span>
                            }
                            @if (HasText(org.Location))
                            {
                                <span class="hmr-item">
                                    <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" Style="color: white !important;" />
                                    <MudText Inline="true" Style="color: white;">@org.Location</MudText>
                                </span>
                            }
                            <span class="hmr-item">
                                <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Small" Style="color: white !important;" />
                                <MudText Inline="true" Style="color: white;">Joined @org.CreatedAt.ToString("MMM d, yyyy")</MudText>
                            </span>
                            @if (HasText(org.LegalStatus) || HasText(org.TaxId))
                            {
                                <span class="hmr-item">
                                    <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Small" Style="color: white !important;" />
                                    <MudText Inline="true" Style="color: white;">@GetLegalLine(org)</MudText>
                                </span>
                            }
                        </div>
                    </div>

                    <aside class="org-hero-card">
                        <div class="hero-card-k">At a glance</div>
                        <div class="hero-card-stats">
                            <div class="hcs">
                                <div class="hcs-v">
                                    @if (LoadSensorCountState.IsLoading)
                                    {
                                        <span class="hcs-v-dim">—</span>
                                    }
                                    else if (LoadSensorCountState.Result is not null)
                                    {
                                        @LoadSensorCountState.Result
                                    }
                                    else
                                    {
                                        <span class="hcs-v-dim">—</span>
                                    }
                                </div>
                                <div class="hcs-k">Sensors live</div>
                            </div>
                            <div class="hcs">
                                <div class="hcs-v">
                                    @if (LoadMembersState.IsLoading)
                                    {
                                        <span class="hcs-v-dim">—</span>
                                    }
                                    else
                                    {
                                        @(LoadMembersState.Result?.Count ?? 0)
                                    }
                                </div>
                                <div class="hcs-k">Members</div>
                            </div>
                        </div>
                        <div class="hero-card-actions">
                            <RequireOrganizationPermission Permission="@OrgPermissions.Organization.Update" OrganizationId="Id">
                                <Authorized>
                                    <MudButton Variant="Variant.Filled" Class="btn-pri-org" StartIcon="@Icons.Material.Outlined.Edit"
                                               Style="color: white !important;"
                                               OnClick="NavigateToEdit">
                                        Edit organization
                                    </MudButton>
                                </Authorized>
                                <NotAuthorized>
                                    @if (AuthState.IsAuthenticated)
                                    {
                                        <MudButton Variant="Variant.Filled" Class="btn-pri-org" StartIcon="@Icons.Material.Outlined.PersonAdd"
                                                   Style="color: white !important;"
                                                   OnClick="OpenRequestAccessDialog">
                                            Request access
                                        </MudButton>
                                    }
                                </NotAuthorized>
                            </RequireOrganizationPermission>
                            <MudButton Variant="Variant.Outlined" Class="btn-ghost-light" StartIcon="@Icons.Material.Outlined.Map"
                                       OnClick="NavigateToMap">
                                View sensor map
                            </MudButton>
                            <RequireOrganizationPermission Permission="@OrgPermissions.Organization.Delete" OrganizationId="Id">
                                <MudButton Variant="Variant.Text" Class="btn-danger-light" StartIcon="@Icons.Material.Outlined.Delete"
                                           OnClick="ConfirmDelete">
                                    Delete
                                </MudButton>
                            </RequireOrganizationPermission>
                        </div>
                    </aside>
                </div>
            </section>

            @* ============================ TABS ============================ *@
            <MudPaper Elevation="0" Class="org-tabs-paper rounded-lg mt-6">
                <Tabs>
                    <Tab Title="Overview" Icon="@Icons.Material.Outlined.Dashboard">
                        <div class="org-tab-body">
                            @if (HasText(org.AboutUs))
                            {
                                <section class="about-card">
                                    <div class="about-eyebrow">Mission</div>
                                    <p class="about-text">@org.AboutUs</p>
                                </section>
                            }

                            <section class="impact-grid">
                                <div class="impact-card primary">
                                    <div class="impact-card-k">
                                        <MudIcon Icon="@Icons.Material.Outlined.SettingsInputAntenna" Size="Size.Small" />
                                        Network
                                    </div>
                                    <div class="impact-card-v">
                                        @if (LoadSensorCountState.IsLoading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        }
                                        else if (LoadSensorCountState.Result is not null)
                                        {
                                            @LoadSensorCountState.Result
                                        }
                                        else
                                        {
                                            @:—
                                        }
                                    </div>
                                    <div class="impact-card-l">Sensors deployed by this organization</div>
                                </div>
                                <div class="impact-card light">
                                    <div class="impact-card-k">
                                        <MudIcon Icon="@Icons.Material.Outlined.Group" Size="Size.Small" />
                                        Team
                                    </div>
                                    <div class="impact-card-v">
                                        @if (LoadMembersState.IsLoading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        }
                                        else
                                        {
                                            @(LoadMembersState.Result?.Count ?? 0)
                                        }
                                    </div>
                                    <div class="impact-card-l">Active members</div>
                                </div>
                                <div class="impact-card light">
                                    <div class="impact-card-k">
                                        <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Small" />
                                        With us since
                                    </div>
                                    <div class="impact-card-v impact-card-v-text">
                                        @org.CreatedAt.Year
                                    </div>
                                    <div class="impact-card-l">Joined @org.CreatedAt.ToString("MMM d, yyyy")</div>
                                </div>
                            </section>

                            <section class="overview-row">
                                <div class="map-card">
                                    <div class="map-card-vis">
                                        <MudIcon Icon="@Icons.Material.Outlined.Map" Class="map-card-bg-icon" />
                                    </div>
                                    <div class="map-card-foot">
                                        <div>
                                            <div class="map-card-title">Sensor map</div>
                                            <div class="map-card-sub">See every deployment on the reserve</div>
                                        </div>
                                        <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward"
                                                   OnClick="NavigateToMap" Class="map-card-link">
                                            Open map
                                        </MudButton>
                                    </div>
                                </div>

                                @if (HasText(org.WebsiteUrl))
                                {
                                    <div class="partner-card">
                                        <MudIcon Icon="@Icons.Material.Outlined.Handshake" Class="partner-card-icon" />
                                        <div class="partner-card-title">Partner with us</div>
                                        <div class="partner-card-desc">
                                            Pitch a project, request data, or get in touch with the team.
                                        </div>
                                        <MudLink Href="@org.WebsiteUrl" Target="_blank" Class="partner-card-link">
                                            Visit @GetDisplayWebsiteUrl(org.WebsiteUrl)
                                        </MudLink>
                                    </div>
                                }
                            </section>
                        </div>
                    </Tab>

                    <Tab Title="Sensors" Icon="@Icons.Material.Outlined.Sensors"
                         Badge="@(LoadSensorCountState.IsLoading ? "..." : LoadSensorCountState.Result?.ToString())">
                        <div class="org-tab-body">
                            <div class="section-head">
                                <div>
                                    <div class="section-eyebrow">Sensor fleet · live</div>
                                    <h2 class="section-title">What's online</h2>
                                </div>
                                <MudStack Row Spacing="2">
                                    <RequireOrganizationPermission Permission="@SensorPermissions.Sensor.Update"
                                                                   OrganizationId="Id">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Settings" OnClick="NavigateToSensors">
                                            Manage
                                        </MudButton>
                                    </RequireOrganizationPermission>
                                    <RequireOrganizationPermission Permission="@SensorPermissions.Sensor.Create"
                                                                   OrganizationId="Id">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Add" OnClick="NavigateToCreateSensor">
                                            Add
                                        </MudButton>
                                    </RequireOrganizationPermission>
                                </MudStack>
                            </div>

                            @if (LoadSensorsState.IsLoading)
                            {
                                <MudGrid Spacing="3">
                                    @for (var i = 0; i < 4; i++)
                                    {
                                        <MudItem xs="12" md="6">
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Class="rounded-lg" />
                                        </MudItem>
                                    }
                                </MudGrid>
                            }
                            else if ((LoadSensorsState.Result?.Count ?? 0) == 0)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center rounded-lg empty-state">
                                    <MudIcon Icon="@Icons.Material.Outlined.SensorsOff" Size="Size.Large"
                                             Color="Color.Secondary" Class="mb-2" />
                                    <MudText Typo="Typo.h6" Color="Color.Secondary">No sensors deployed</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Deploy a sensor to start gathering ecological data.
                                    </MudText>
                                </MudPaper>
                            }
                            else
                            {
                                <MudGrid Spacing="3">
                                    @foreach (var sensor in LoadSensorsState.Result ?? [])
                                    {
                                        <MudItem xs="12" md="6">
                                            <SensorListItem Sensor="sensor" OnClick="NavigateToSensor" />
                                        </MudItem>
                                    }
                                </MudGrid>
                                @if (LoadSensorCountState.Result > MaxDisplayedSensors)
                                {
                                    <div class="d-flex justify-center mt-4">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary"
                                                   EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="NavigateToSensors">
                                            View all @LoadSensorCountState.Result sensors
                                        </MudButton>
                                    </div>
                                }
                            }
                        </div>
                    </Tab>

                    <Tab Title="Team" Icon="@Icons.Material.Outlined.Group"
                         Badge="@(LoadMembersState.IsLoading ? "..." : (LoadMembersState.Result?.Count ?? 0).ToString())">
                        <div class="org-tab-body">
                            <div class="section-head">
                                <div>
                                    <div class="section-eyebrow">Leadership</div>
                                    <h2 class="section-title">The team</h2>
                                </div>
                                <RequireOrganizationPermission Permission="@OrgPermissions.Organization.ManageMembers"
                                                               OrganizationId="Id">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Settings" OnClick="NavigateToTeam">
                                        Manage
                                    </MudButton>
                                </RequireOrganizationPermission>
                            </div>

                            @if (LoadMembersState.IsLoading)
                            {
                                <MudGrid Spacing="3">
                                    @for (var i = 0; i < 4; i++)
                                    {
                                        <MudItem xs="12" sm="6" md="4" lg="3">
                                            <MudPaper Elevation="0" Outlined="true" Class="pa-4 text-center rounded-lg">
                                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="56px" Height="56px"
                                                             Class="mx-auto mb-3" />
                                                <MudSkeleton Width="80%" Class="mx-auto mb-2" />
                                                <MudSkeleton Width="50%" Class="mx-auto" />
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                            }
                            else if ((LoadMembersState.Result?.Count ?? 0) == 0)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center rounded-lg empty-state">
                                    <MudIcon Icon="@Icons.Material.Outlined.GroupOff" Size="Size.Large" Color="Color.Secondary"
                                             Class="mb-2" />
                                    <MudText Typo="Typo.h6" Color="Color.Secondary">No team members</MudText>
                                </MudPaper>
                            }
                            else
                            {
                                <div class="team-grid">
                                    @foreach (var member in (LoadMembersState.Result ?? []).Take(MaxDisplayedMembers))
                                    {
                                        <div class="team-cell">
                                            <MudAvatar Size="Size.Medium" Color="@GetMemberAvatarColor(member.DisplayName)" Class="team-av">
                                                @GetMemberInitial(member.DisplayName)
                                            </MudAvatar>
                                            <div class="team-text">
                                                <div class="team-name">@member.DisplayName</div>
                                                <div class="team-role">@member.RoleName</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if ((LoadMembersState.Result?.Count ?? 0) > MaxDisplayedMembers)
                                {
                                    <div class="d-flex justify-center mt-4">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary"
                                                   EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="NavigateToTeam">
                                            View all @(LoadMembersState.Result?.Count ?? 0) members
                                        </MudButton>
                                    </div>
                                }
                            }
                        </div>
                    </Tab>

                    <Tab Title="Projects" Icon="@Icons.Material.Outlined.AccountTree">
                        <div class="org-tab-body">
                            <div class="coming-soon">
                                <div class="coming-soon-eyebrow">Coming soon</div>
                                <h2 class="coming-soon-title">Field projects</h2>
                                <p class="coming-soon-body">
                                    Track active field operations, completion dates, and the sensors scoped to each project.
                                    Tracked in <a href="https://github.com/andres-m-rodriguez/EcoData/issues/209" target="_blank" rel="noopener">issue #209</a>.
                                </p>
                            </div>
                        </div>
                    </Tab>

                    <Tab Title="Research" Icon="@Icons.Material.Outlined.Science">
                        <div class="org-tab-body">
                            <div class="coming-soon">
                                <div class="coming-soon-eyebrow">Coming soon</div>
                                <h2 class="coming-soon-title">Publications</h2>
                                <p class="coming-soon-body">
                                    Latest papers, dataset DOIs, and citations referencing this organization's data.
                                    Tracked in <a href="https://github.com/andres-m-rodriguez/EcoData/issues/209" target="_blank" rel="noopener">issue #209</a>.
                                </p>
                            </div>
                        </div>
                    </Tab>
                </Tabs>
            </MudPaper>
        }
    </div>
</PageShell>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private const int MaxDisplayedSensors = 6;
    private const int MaxDisplayedMembers = 10;

    private OrganizationDtoForDetail? _organization;
    private string? _loadError;

    protected override void OnInitialized()
    {
        // Pre-seed from the cache before base.OnInitialized() fires the RunOnLoad
        // commands, so a cached organization renders instantly while LoadOrganization
        // refreshes it in the background (stale-while-revalidate).
        _organization = OrganizationCache.Get(Id);
        base.OnInitialized();
    }

    [Command, RunOnLoad]
    private async Task<OrganizationDtoForDetail?> LoadOrganization(CancellationToken ct)
    {
        var result = await OrganizationClient.GetByIdAsync(Id, ct);
        if (!result.TryPickT0(out var organization, out var error))
        {
            _loadError = error.StatusCode switch
            {
                404 => null,
                0 => "Couldn't reach the server.",
                _ => error.Message ?? "Couldn't load this organization."
            };
            return null;
        }

        _organization = organization;
        OrganizationCache.Set(organization);
        return organization;
    }

    [Command, RunOnLoad]
    private async Task<int?> LoadSensorCount(CancellationToken ct)
    {
        var result = await SensorClient.GetSensorCountAsync(
            new SensorParameters(PageSize: MaxDisplayedSensors, OrganizationId: Id), ct);
        if (!result.TryPickT0(out var count, out var error))
        {
            _loadError = error.StatusCode == 0
                ? "Couldn't reach the server."
                : error.Message ?? "Couldn't load the sensor count.";
            return null;
        }
        return count;
    }

    [Command, RunOnLoad]
    private async Task<List<SensorDtoForList>> LoadSensors(CancellationToken ct)
    {
        var sensors = new List<SensorDtoForList>();
        await foreach (var sensor in SensorClient.GetSensorsAsync(
            new SensorParameters(PageSize: MaxDisplayedSensors, OrganizationId: Id), ct))
        {
            sensors.Add(sensor);
        }
        return sensors;
    }

    [Command, RunOnLoad]
    private async Task<List<OrganizationMemberDto>> LoadMembers(CancellationToken ct)
    {
        var members = new List<OrganizationMemberDto>();
        await foreach (var member in MemberClient.GetAllAsync(Id, new OrganizationMemberParameters(), ct))
        {
            members.Add(member);
        }
        return members;
    }

    private async Task OpenRequestAccessDialog()
    {
        if (_organization is not { } org) return;

        var orgForList = new OrganizationDtoForList(
            Id: org.Id,
            Name: org.Name,
            Slug: org.Slug,
            Tagline: org.Tagline,
            ProfilePictureUrl: org.ProfilePictureUrl,
            CardPictureUrl: org.CardPictureUrl,
            AboutUs: org.AboutUs,
            WebsiteUrl: org.WebsiteUrl,
            Location: org.Location,
            PrimaryColor: org.PrimaryColor,
            AccentColor: org.AccentColor,
            Type: org.Type,
            CreatedAt: org.CreatedAt
        );

        var parameters = new DialogParameters<RequestAccessDialog>
        {
            { x => x.PreselectedOrganization, orgForList }
        };

        await DialogService.ShowAsync<RequestAccessDialog>("Request Access", parameters);
    }

    private void NavigateToEdit() => Navigation.NavigateTo($"/organizations/{Id}/edit");
    private void NavigateToSensors() => Navigation.NavigateTo($"/organizations/{Id}/sensors");
    private void NavigateToTeam() => Navigation.NavigateTo($"/organizations/{Id}/team");
    private void NavigateToMap() => Navigation.NavigateTo($"/organizations/{Id}/map");
    private void NavigateToSensor(SensorDtoForList sensor) => Navigation.NavigateTo($"/sensor/{sensor.Id}");
    private void NavigateToCreateSensor() => Navigation.NavigateTo($"/organizations/{Id}/sensors/create");

    private async Task ConfirmDelete()
    {
        if (_organization is null) return;

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete \"{_organization.Name}\"?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete", parameters);
        var dialogResult = await dialog.Result;

        if (dialogResult is { Canceled: false })
        {
            var result = await OrganizationClient.DeleteAsync(Id);
            result.Switch(
                _ =>
                {
                    Snackbar.Add("Deleted", Severity.Success);
                    Navigation.NavigateTo("/organizations/discover");
                },
                error => Snackbar.Add(error.Message ?? "Failed to delete organization", Severity.Error)
            );
        }
    }

    // Inline CSS variables that scope per-org branding to the page. Falls back
    // to MudBlazor palette tokens when the org hasn't picked colors yet, so
    // the layout reads correctly either way.
    private string ThemeStyle => _organization is { } org
        ? $"--org-primary: {org.PrimaryColor ?? "var(--mud-palette-primary)"}; " +
          $"--org-accent: {org.AccentColor ?? "var(--mud-palette-secondary)"};"
        : string.Empty;

    private static bool HasText(string? value) => !string.IsNullOrWhiteSpace(value);

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
    }

    private static string GetDisplayWebsiteUrl(string? websiteUrl) =>
        Uri.TryCreate(websiteUrl, UriKind.Absolute, out var uri)
            ? uri.Host
            : websiteUrl ?? string.Empty;

    private static string GetLegalLine(OrganizationDtoForDetail org) =>
        (HasText(org.LegalStatus), HasText(org.TaxId)) switch
        {
            (true, true) => $"{org.LegalStatus} · {org.TaxId}",
            (true, false) => org.LegalStatus!,
            (false, true) => org.TaxId!,
            _ => string.Empty
        };

    private static char GetMemberInitial(string displayName) =>
        string.IsNullOrWhiteSpace(displayName) ? '?' : char.ToUpper(displayName[0]);

    private static Color GetMemberAvatarColor(string displayName)
    {
        var colors = new[]
        {
            Color.Primary,
            Color.Secondary,
            Color.Tertiary,
            Color.Info,
            Color.Success,
            Color.Warning,
        };
        var hash = displayName.GetHashCode();
        return colors[Math.Abs(hash) % colors.Length];
    }
}