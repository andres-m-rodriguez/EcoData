@using EcoData.Common.Pagination.Blazor
@using EcoData.Sensors.Contracts.Dtos
@using EcoData.Sensors.Contracts.Parameters
@using EcoData.Sensors.Application.Client
@using EcoPortal.Client.Features.Organizations.Workspace
@using EcoPortal.Client.Services
@implements IAsyncDisposable
@inject IJavascriptSafeInterop JS
@inject ILocationHttpClient LocationClient
@inject ISensorHttpClient SensorClient
@inject INavigationManager Navigation

<div class="@(_isFullscreen ? "org-map is-fullscreen" : "org-map")">
    <UiSectionHead Title="Sensor map" Eyebrow="Where" Subtitle="Pick a municipio to see the stations in it.">
        <Actions>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@(_isFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                       OnClick="ToggleFullscreen">
                @(_isFullscreen ? "Exit full screen" : "Full screen")
            </MudButton>
        </Actions>
    </UiSectionHead>

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _loadError = null">
            @_loadError
        </MudAlert>
    }

    <div class="org-map-body">
        <div id="@_elementId" class="org-map-leaflet" @ref="_host"></div>

        @if (_selectedMunicipalityName is not null)
        {
            <MapDetailPanel Title="@_selectedMunicipalityName"
                            Subtitle="@GetSensorCountText()"
                            IsOpen="@_panelOpen"
                            OnClose="ClosePanel">
                <EcoDataVirtualizedList @key="_selectedMunicipalityId"
                                        @ref="_sensorList"
                                        TItem="SensorDtoForList"
                                        TParams="SensorParameters"
                                        ItemsProvider="(p, ct) => SensorClient.GetSensorsAsync(p, ct)"
                                        ParametersBuilder="BuildSensorParameters"
                                        CursorSelector="s => s.Id"
                                        ItemSize="72">
                    <LoadingTemplate>
                        <MapDetailPanelLoading />
                    </LoadingTemplate>
                    <EmptyTemplate>
                        <MapDetailPanelEmpty Icon="@Icons.Material.Outlined.SensorsOff" Message="No sensors in this municipality" />
                    </EmptyTemplate>
                    <ItemTemplate Context="sensor">
                        <MapDetailPanelItem OnClick="() => NavigateToSensor(sensor.Id)">
                            <div class="d-flex justify-space-between align-start">
                                <div>
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@sensor.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@sensor.ExternalId</MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="@(sensor.IsActive ? Color.Success : Color.Default)" Variant="Variant.Text">
                                    @(sensor.IsActive ? "Active" : "Inactive")
                                </MudChip>
                            </div>
                        </MapDetailPanelItem>
                    </ItemTemplate>
                </EcoDataVirtualizedList>
            </MapDetailPanel>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required OrganizationContext Context { get; set; }

    private Guid Id => Context.Organization.Id;

    private readonly string _elementId = $"org-map-{Guid.NewGuid():N}";
    // Captured only once the host div has rendered — the workspace renders it
    // after its context loads, which is later than this section's first render.
    private ElementReference _host;
    private bool _mapInitialized;
    private bool _isFullscreen;
    private bool _panelOpen;
    private string? _selectedMunicipalityName;
    private string? _loadError;
    private Guid? _selectedMunicipalityId;
    private int? _sensorCount;
    private EcoDataVirtualizedList<SensorDtoForList, SensorParameters>? _sensorList;
    private DotNetObjectReference<MapSection>? _dotNetRef;

    // The map host only exists once the workspace has its context, so the
    // first render that finds it is the one that starts Leaflet.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapInitialized)
        {
            return;
        }

        if (string.IsNullOrEmpty(_host.Id))
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("orgSensorMap.init", _elementId, _dotNetRef);
        _mapInitialized = true;

        var geoJsonResult = await LocationClient.GetMunicipalitiesGeoJsonAsync("PR");
        if (!geoJsonResult.TryPickT0(out var geoJson, out var geoJsonError))
        {
            _loadError = geoJsonError.StatusCode == 0
                ? "Couldn't reach the server."
                : geoJsonError.Message ?? "Couldn't load municipality boundaries.";
            StateHasChanged();
            return;
        }

        await JS.InvokeVoidAsync("orgSensorMap.addMunicipalities", _elementId, geoJson.RootElement);
    }

    [JSInvokable]
    public async Task HandleMunicipalitySelected(Guid municipalityId, string municipalityName)
    {
        _selectedMunicipalityId = municipalityId;
        _selectedMunicipalityName = municipalityName;
        _sensorCount = null;
        _panelOpen = false;
        StateHasChanged();

        await Task.Delay(10);
        _panelOpen = true;
        StateHasChanged();

        var countResult = await SensorClient.GetSensorCountAsync(
            new SensorParameters(OrganizationId: Id, MunicipalityId: municipalityId)
        );
        if (!countResult.TryPickT0(out var count, out var countError))
        {
            _loadError = countError.StatusCode == 0
                ? "Couldn't reach the server."
                : countError.Message ?? "Couldn't load the sensor count.";
            StateHasChanged();
            return;
        }

        _sensorCount = count;
        StateHasChanged();
    }

    private SensorParameters BuildSensorParameters(Guid? cursor) =>
        new(Cursor: cursor, OrganizationId: Id, MunicipalityId: _selectedMunicipalityId);

    [JSInvokable]
    public void HandleMunicipalityCleared() => ClosePanel();

    private void ClosePanel()
    {
        _panelOpen = false;
        StateHasChanged();

        _ = Task.Delay(300).ContinueWith(_ =>
        {
            _selectedMunicipalityId = null;
            _selectedMunicipalityName = null;
            _sensorCount = null;
            InvokeAsync(StateHasChanged);
        });

        _ = JS.InvokeVoidAsync("orgSensorMap.clearMunicipalitySelection", _elementId).AsTask();
    }

    private string GetSensorCountText() =>
        _sensorCount is null ? "Loading..." : $"{_sensorCount} sensor{(_sensorCount == 1 ? "" : "s")}";

    private void NavigateToSensor(Guid sensorId) => Navigation.NavigateTo($"/sensor/{sensorId}");

    private async Task ToggleFullscreen()
    {
        _isFullscreen = !_isFullscreen;
        StateHasChanged();

        // Leaflet measures its host once; the host just changed size.
        await Task.Delay(50);
        if (_mapInitialized)
        {
            await JS.InvokeVoidAsync("orgSensorMap.invalidateSize", _elementId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_mapInitialized)
        {
            await JS.InvokeVoidAsync("orgSensorMap.dispose", _elementId);
        }
    }
}
