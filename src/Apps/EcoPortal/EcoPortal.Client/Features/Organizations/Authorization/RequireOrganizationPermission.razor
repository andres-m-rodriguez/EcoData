@using EcoPortal.Client.Services
@inherits StatefulComponent
@inject AuthStateService AuthState
@inject PermissionContextService PermissionContext

@if (CheckPermissionState.IsLoading || !CheckPermissionState.HasResult)
{
    @if (Loading is not null)
    {
        @Loading
    }
}
else if (CheckPermissionState.Result)
{
    @if (Authorized is not null)
    {
        @Authorized
    }
    else
    {
        @ChildContent
    }
}
else if (NotAuthorized is not null)
{
    @NotAuthorized
}

@code {
    [Parameter]
    public string Permission { get; set; } = string.Empty;

    [Parameter]
    public Guid OrganizationId { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Authorized { get; set; }

    [Parameter]
    public RenderFragment? NotAuthorized { get; set; }

    [Parameter]
    public RenderFragment? Loading { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // [Event] requires a record nested in this component; MainLayout owns AuthChanged,
        // so cross-class consumers subscribe through the base's auto-disposed hook instead.
        SubscribeEvent<MainLayout.AuthChanged>(_ => DispatchEvent(() => CheckPermissionState.TryExecute()));
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckPermissionState.Execute();
    }

    // Trailing token buys latest-wins: a re-check triggered by new parameters or an
    // auth change discards any stale in-flight result.
    [Command]
    private async Task<bool> CheckPermission(CancellationToken ct)
    {
        if (!AuthState.IsInitialized)
        {
            await AuthState.InitializeAsync();
        }

        if (AuthState.IsGlobalAdmin)
        {
            return true;
        }

        if (OrganizationId == Guid.Empty || string.IsNullOrEmpty(Permission))
        {
            return false;
        }

        return await PermissionContext.HasPermissionAsync(OrganizationId, Permission);
    }
}