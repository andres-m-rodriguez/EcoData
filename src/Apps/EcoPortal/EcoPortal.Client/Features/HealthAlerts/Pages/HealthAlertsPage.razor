@page "/alerts"
@using BlazorStaticNavigation
@using EcoPortal.Client.Features.HealthAlerts.Components
@inject Navbar Navbar
@inject PageNavigation PageNavigation

<PageTitle>Health Alerts - EcoData</PageTitle>

<div class="alerts-page">
    <section class="alerts-content">
        <HealthAlertList />
    </section>
</div>

@code {
    protected override void OnParametersSet() => PageNavigation.Record();

    protected override void OnInitialized()
    {
        Navbar.SetTitle("Alerts");
    }
}
