@* Debounced search field with optional filter button and action slot. Sticks below
   the app bar via pure CSS (position: sticky) — no JS involved. *@

<div class="search-header-wrapper">
    <div class="search-header-content">
        <div class="search-wrapper">
            <div class="search-bar">
                <MudTextField T="string"
                              Value="@Value"
                              ValueChanged="@ValueChanged"
                              Placeholder="@Placeholder"
                              Variant="Variant.Text"
                              Margin="Margin.None"
                              Underline="false"
                              Immediate="true"
                              DebounceInterval="300"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="search-input" />
                @if (ShowFilterButton)
                {
                    <div class="search-divider"></div>
                    <button type="button" class="filter-btn @(HasActiveFilters ? "active" : "")"
                            @onclick="OnFilterClick">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                        <span>Filter</span>
                        @if (HasActiveFilters && FilterCount > 0)
                        {
                            <span class="filter-badge">@FilterCount</span>
                        }
                    </button>
                }
            </div>
        </div>
        @if (ActionButtons is not null)
        {
            <div class="actions-wrapper">
                @ActionButtons
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Search...";

    [Parameter]
    public bool ShowFilterButton { get; set; }

    [Parameter]
    public bool HasActiveFilters { get; set; }

    [Parameter]
    public int FilterCount { get; set; }

    [Parameter]
    public EventCallback OnFilterClick { get; set; }

    [Parameter]
    public RenderFragment? ActionButtons { get; set; }

    /// <summary>Unused: stickiness is pure CSS now. The old JS observer imported a
    /// script that never shipped. Kept only so existing call sites keep compiling.</summary>
    [Parameter]
    public bool EnableSticky { get; set; } = true;
}
