@inject IJavascriptSafeInterop JS
@implements IAsyncDisposable

<div class="search-header-wrapper @(_isSticky ? "is-sticky" : "")" @ref="_headerRef">
    <div class="search-header-content">
        <div class="search-wrapper">
            <NuiSearchBar Value="@Value" ValueChanged="ValueChanged" Placeholder="@Placeholder"
                          ShowFilterButton="ShowFilterButton" HasActiveFilters="HasActiveFilters"
                          FilterCount="FilterCount" OnFilterClick="OnFilterClick"
                          EnableSticky="false" />
        </div>
        @if (ActionButtons is not null)
        {
            <div class="actions-wrapper">
                @ActionButtons
            </div>
        }
    </div>
</div>

@code {
    private ElementReference _headerRef;
    private bool _isSticky;
    private bool _disposed;
    private DotNetObjectReference<SearchHeader>? _dotNetRef;
    private IJSObjectReference? _jsModule;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Search...";

    [Parameter]
    public bool ShowFilterButton { get; set; }

    [Parameter]
    public bool HasActiveFilters { get; set; }

    [Parameter]
    public int FilterCount { get; set; }

    [Parameter]
    public EventCallback OnFilterClick { get; set; }

    [Parameter]
    public RenderFragment? ActionButtons { get; set; }

    [Parameter]
    public bool EnableSticky { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !EnableSticky)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);

        // Stickiness is an enhancement: without the module the header just scrolls.
        var imported = await JS.ImportAsync("./js/stickySearch.js");
        if (_disposed || !imported.TryPickT0(out var module, out _))
        {
            return;
        }

        _jsModule = module;
        await JS.InvokeVoidAsync(module, "initStickySearch", _headerRef, _dotNetRef);
    }

    [JSInvokable]
    public void SetSticky(bool isSticky)
    {
        if (_isSticky != isSticky)
        {
            _isSticky = isSticky;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_jsModule is not null)
        {
            await JS.InvokeVoidAsync(_jsModule, "destroyStickySearch");
            await JS.DisposeAsync(_jsModule);
        }

        _dotNetRef?.Dispose();
    }
}
