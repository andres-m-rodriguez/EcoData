@namespace EcoPortal.Client.Components.Shell
@using EcoPortal.Client.Services
@inherits StatefulComponent
@inject ITabNavigationService Tabs


<nav class="@BarClass" aria-hidden="@(_hidden ? "true" : "false")">
    <MudStack Row="true" Justify="Justify.SpaceAround" AlignItems="AlignItems.Center" Class="bottom-nav-container">
        @foreach (var (tab, icon, label) in Tabs_)
        {
            <MudButton Variant="Variant.Text"
                       Color="@(Tabs.CurrentTab == tab ? Color.Primary : Color.Default)"
                       Class="@(Tabs.CurrentTab == tab ? "bottom-nav-item is-active" : "bottom-nav-item")"
                       OnClick="@(() => Tabs.NavigateToTab(tab))">
                <MudStack AlignItems="AlignItems.Center" Spacing="0">
                    <MudIcon Icon="@icon" Size="Size.Small" />
                    <MudText Typo="Typo.caption">@label</MudText>
                </MudStack>
            </MudButton>
        }
    </MudStack>
</nav>

@code {
    private static readonly (NavigationTab Tab, string Icon, string Label)[] Tabs_ =
    [
        (NavigationTab.Home, Icons.Material.Filled.Home, "Home"),
        (NavigationTab.Data, Icons.Material.Filled.QueryStats, "Data"),
        (NavigationTab.Monitor, Icons.Material.Filled.Sensors, "Monitor"),
        (NavigationTab.Orgs, Icons.Material.Filled.Groups, "Orgs"),
        (NavigationTab.Account, Icons.Material.Filled.Person, "Account"),
    ];
}
