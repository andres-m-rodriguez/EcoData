@inherits StatefulComponent
@using EcoData.Locations.Contracts.Dtos
@using EcoPortal.Client.Services
@implements IAsyncDisposable
@inject ILocationHttpClient LocationClient
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row="true" Spacing="2">
        <MudNumericField Value="_latitude"
                         ValueChanged="@(async (decimal v) => await OnLatitudeChanged(v))"
                         Label="Latitude"
                         Min="-90"
                         Max="90"
                         Step="0.000001M"
                         Format="F6"
                         HelperText="-90 to 90"
                         Disabled="IsLoading"
                         Immediate="true"
                         Style="flex: 1;" />

        <MudNumericField Value="_longitude"
                         ValueChanged="@(async (decimal v) => await OnLongitudeChanged(v))"
                         Label="Longitude"
                         Min="-180"
                         Max="180"
                         Step="0.000001M"
                         Format="F6"
                         HelperText="-180 to 180"
                         Disabled="IsLoading"
                         Immediate="true"
                         Style="flex: 1;" />
    </MudStack>

    <MudStack Row="true" Justify="Justify.FlexEnd">
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.MyLocation"
                   OnClick="() => GetCurrentLocationState.Execute()"
                   Disabled="IsLoading || GetCurrentLocationState.IsLoading">
            @if (GetCurrentLocationState.IsLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Use my location
        </MudButton>
    </MudStack>

    <LeafletMap @ref="_map"
                Latitude="(double?)InitialLatitude"
                Longitude="(double?)InitialLongitude"
                ShowMarker="InitialLatitude != 0 && InitialLongitude != 0"
                OnMapClick="OnMapClicked" />

    @if (!string.IsNullOrEmpty(_geolocationError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true"
                  ShowCloseIcon="true" CloseIconClicked="() => GeolocationErrorState.Value = null">
            <MudText Typo="Typo.body2">@_geolocationError</MudText>
        </MudAlert>
    }

    @if (ValidateLocationState.IsLoading)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Validating location...</MudText>
        </MudStack>
    }
    else if (_municipality is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
            <MudText Typo="Typo.body2">
                <strong>@_municipality.Name</strong>, @_municipality.StateName
            </MudText>
        </MudAlert>
    }
    else if (_hasValidationError)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            <MudText Typo="Typo.body2">
                Location is outside supported regions. Please select a location within a supported area.
            </MudText>
        </MudAlert>
    }
</MudStack>

@code {
    private LeafletMap? _map;

    [Reactive] private decimal _latitude;
    [Reactive] private decimal _longitude;
    [Reactive] private string? _geolocationError;
    [Reactive] private MunicipalityDtoForDetail? _municipality;
    [Reactive] private bool _hasValidationError;

    [Parameter] public decimal InitialLatitude { get; set; }
    [Parameter] public decimal InitialLongitude { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<LocationSelectedEventArgs> OnLocationChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (InitialLatitude != 0 && InitialLongitude != 0 && _latitude == 0 && _longitude == 0)
        {
            // Programmatic seed from parameters; a render follows anyway.
            LatitudeState.SetSilently(InitialLatitude);
            LongitudeState.SetSilently(InitialLongitude);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _latitude != 0 && _longitude != 0)
        {
            await ValidateLocationState.Execute();
        }
    }

    [Command]
    private async Task GetCurrentLocation()
    {
        if (_map is null) return;

        GeolocationErrorState.Value = null;
        var result = await _map.GetCurrentLocationAsync();

        if (result.Success && result.Latitude.HasValue && result.Longitude.HasValue)
        {
            LatitudeState.Value = (decimal)result.Latitude.Value;
            LongitudeState.Value = (decimal)result.Longitude.Value;
            await ValidateLocationState.Execute();
        }
        else
        {
            GeolocationErrorState.Value = result.Error ?? "Unable to get current location";
        }
    }

    [Command]
    private async Task ValidateLocation()
    {
        HasValidationErrorState.Value = false;
        MunicipalityState.Value = null;

        var result = await LocationClient.GetMunicipalityByPointAsync(_latitude, _longitude);
        if (result.TryPickT0(out var municipality, out var error))
        {
            MunicipalityState.Value = municipality;
        }
        else if (error.StatusCode == 404)
        {
            HasValidationErrorState.Value = true;
        }
        else
        {
            Snackbar.Add(
                error.StatusCode == 0
                    ? "Couldn't reach the server."
                    : error.Message ?? "Couldn't validate the location.",
                Severity.Error);
        }

        await OnLocationChanged.InvokeAsync(new LocationSelectedEventArgs(
            _latitude,
            _longitude,
            _municipality
        ));
    }

    private async Task OnMapClicked(MapClickEventArgs args)
    {
        LatitudeState.Value = (decimal)args.Latitude;
        LongitudeState.Value = (decimal)args.Longitude;
        GeolocationErrorState.Value = null;

        await ValidateLocationState.Execute();
    }

    private async Task OnLatitudeChanged(decimal value)
    {
        LatitudeState.Value = value;
        await OnCoordinatesChanged();
    }

    private async Task OnLongitudeChanged(decimal value)
    {
        LongitudeState.Value = value;
        await OnCoordinatesChanged();
    }

    private async Task OnCoordinatesChanged()
    {
        if (_latitude < -90 || _latitude > 90 || _longitude < -180 || _longitude > 180)
            return;

        if (_latitude != 0 && _longitude != 0 && _map is not null)
        {
            await _map.SetMarkerAsync((double)_latitude, (double)_longitude);
            await ValidateLocationState.Execute();
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Blazor prefers async disposal when both are present; run the Tempest
        // base cleanup here so bus subscriptions still unhook.
        Dispose();

        if (_map is not null)
        {
            await _map.DisposeAsync();
        }
    }

    public sealed record LocationSelectedEventArgs(
        decimal Latitude,
        decimal Longitude,
        MunicipalityDtoForDetail? Municipality
    );
}
