@using EcoPortal.Client.Services
@inherits StatefulComponent
@inject NotificationService NotificationService

<MudBadge Content="@UnreadCountDisplay"
          Visible="@HasUnread"
          Color="Color.Error"
          Overlap="true"
          Class="notification-bell">
    <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                   Color="Color.Default"
                   Size="Size.Medium"
                   OnClick="TogglePanel" />
</MudBadge>

<MudOverlay Visible="_isPanelOpen" OnClick="ClosePanel" LockScroll="false" />

<MudPopover Open="@_isPanelOpen"
            Fixed="true"
            AnchorOrigin="Origin.BottomRight"
            TransformOrigin="Origin.TopRight"
            Class="notification-popover">
    <NotificationPanel OnClose="ClosePanel" />
</MudPopover>

@code {
    /// <summary>Published by NotificationService whenever the unread count changes; the badge re-renders.</summary>
    public sealed record UnreadCountChanged(int Count);

    private bool _isPanelOpen;
    private int _unreadCount;

    private bool HasUnread => _unreadCount > 0;

    private string UnreadCountDisplay =>
        _unreadCount > 99 ? "99+" : _unreadCount.ToString();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _unreadCount = NotificationService.UnreadCount;
    }

    [Event]
    private void OnUnreadCountChanged(UnreadCountChanged e) => _unreadCount = e.Count;

    private void TogglePanel()
    {
        _isPanelOpen = !_isPanelOpen;
    }

    private void ClosePanel()
    {
        _isPanelOpen = false;
    }
}

<style>
    .notification-bell {
        margin-right: 8px;
    }

    /* Pull the unread-count badge inward so it sits on the icon's top-right corner.
       MudBadge's .Class lands on the .mud-badge-root wrapper; the actual bubble is
       its child .mud-badge. We need !important to beat MudBlazor's default position
       rules (top: 14%; right: 14%; transform: translate(50%, -50%)) which were
       pulling the badge above the button. */
    .notification-bell .mud-badge {
        top: 8px !important;
        right: 8px !important;
        transform: none !important;
    }

    .notification-popover {
        width: 340px;
        max-height: 440px;
        overflow: hidden;
    }
</style>
