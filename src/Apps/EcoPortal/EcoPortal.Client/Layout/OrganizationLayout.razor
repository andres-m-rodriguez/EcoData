@inherits LayoutComponentBase
@using EcoPortal.Client.Features.Organizations.Workspace

<EpShell Rail="RailContent">
    @Body
</EpShell>

@code {
    [CascadingParameter]
    public RouteData? RouteData { get; set; }

    private Guid? OrganizationId =>
        RouteData?.RouteValues.TryGetValue("Id", out var value) == true
            ? value switch
            {
                Guid id => id,
                string text when Guid.TryParse(text, out var parsed) => parsed,
                _ => null,
            }
            : null;

    private string ActiveKey =>
        OrganizationSections.Key(
            OrganizationSections.FromSegment(RouteData?.RouteValues.GetValueOrDefault("Section") as string));

    private RenderFragment? RailContent =>
        OrganizationId is { } organizationId
            ? @<OrganizationRail OrganizationId="organizationId" ActiveKey="@ActiveKey" />
            : null;
}
