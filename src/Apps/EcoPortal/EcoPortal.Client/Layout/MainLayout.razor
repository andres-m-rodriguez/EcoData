@inherits StatefulLayoutComponent
@using EcoPortal.Client.Components
@using EcoPortal.Client.Components.Shell
@using EcoPortal.Client.Pages
@using EcoPortal.Client.Services
@using EcoPortal.Client.Themes
@inject AuthStateService AuthState
@inject INavigationManager Navigation
@inject INavbarManager Navbar
@inject ITabNavigationService Tabs
@inject NotificationService NotificationService

<MudThemeProvider Theme="AppThemes.Azure" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* .ep-shell is the ground every panel floats in. It is also the only plain
   element wrapping MudLayout/MudAppBar/MudMainContent, so it is what carries
   Blazor's scope attribute — every ::deep rule in the stylesheet resolves
   through it. *@
<div class="ep-shell">
    <MudLayout>
        <MudAppBar Elevation="0" Fixed="true" Class="ep-appbar">
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <EpMobileTitle />
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <div class="d-flex align-center">
                    <a href="/" class="logo-text">Ecoportal</a>
                    @if (ShowTitleDivider)
                    {
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-4 my-3" />
                        <span class="page-title">@Navbar.State.Title</span>
                    }
                </div>
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <nav class="ep-nav ml-6">
                    @foreach (var (href, label, match) in NavLinks)
                    {
                        <a href="@href" class="@NavLinkClass(match)">@label</a>
                    }
                </nav>
            </MudHidden>

            <MudSpacer />

            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <EpSearch />
            </MudHidden>

            @if (AuthState.IsAuthenticated)
            {
                <NotificationBell />
            }

            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                @if (Tabs.CurrentTab != NavigationTab.Home)
                {
                    <NuiNativeNavbar ShowBackButton="false" ShowTitle="false" />
                }
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                @if (AuthState.IsAuthenticated)
                {
                    <a href="/account" class="ep-user-pill">
                        <span class="ep-user-initial">@UserInitial</span>
                        <span class="ep-user-name">@AuthState.CurrentUser?.DisplayName</span>
                    </a>
                }
                else
                {
                    <a href="/login" class="ep-signin">Sign in</a>
                }
            </MudHidden>
        </MudAppBar>

        <MudMainContent Class="main-content">
            <div class="ep-shell-body">
                <div class="ep-main-panel">
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        @if (AuthState.IsAuthenticated && IsOrganizationsArea)
                        {
                            <nav class="ep-subnav">
                                @foreach (var (href, label, icon) in OrganizationLinks)
                                {
                                    <a href="@href" class="@SubnavLinkClass(href)">
                                        <MudIcon Icon="@icon" Size="Size.Small" />
                                        <span>@label</span>
                                    </a>
                                }
                            </nav>
                        }
                    </MudHidden>

                    @if (IsFullBleedPage)
                    {
                        <div class="@_pageTransitionClass" @key="_navigationKey">
                            @Body
                        </div>
                    }
                    else
                    {
                        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 px-4">
                            <div class="@_pageTransitionClass" @key="_navigationKey">
                                @Body
                            </div>
                        </MudContainer>
                    }
                </div>
            </div>
        </MudMainContent>
    </MudLayout>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <EpBottomNav />
    </MudHidden>
</div>

@code {
    /// <summary>The signed-in user changed (login, logout, profile update).
    /// Published by <see cref="AuthStateService"/>; anyone showing auth-derived
    /// chrome reacts through this record.</summary>
    public sealed record AuthChanged;

    private static readonly (string Href, string Label, string Match)[] NavLinks =
    [
        (HomePage.Path, "Home", HomePage.Path),
        (DataHubPage.Path, "Data", DataHubPage.Path),
        (SensorsPage.Path, "Sensors", SensorsPage.Path),
        (HealthAlertsPage.Path, "Alerts", HealthAlertsPage.Path),
        ("/organizations/discover", "Organizations", "/organizations"),
        (GettingStartedPage.Path, "Getting Started", GettingStartedPage.Path),
        (ContactPage.Path, "Contact", ContactPage.Path),
    ];

    private static readonly (string Href, string Label, string Icon)[] OrganizationLinks =
    [
        ("/organizations/discover", "Discover", Icons.Material.Outlined.Explore),
        ("/organizations/my", "My Organizations", Icons.Material.Outlined.Business),
        ("/organizations/requests", "Access Requests", Icons.Material.Outlined.HowToReg),
    ];

    private string _pageTransitionClass = "";
    private string _navigationKey = Guid.NewGuid().ToString();
    private string _lastUri = "";

    private string Path => Navigation.State.Path;

    private bool IsHomePage => Tabs.CurrentTab == NavigationTab.Home;

    private bool IsOrganizationsArea =>
        Path.StartsWith("/organizations", StringComparison.OrdinalIgnoreCase);

    // Pages that draw their own chrome get @Body with no container.
    private bool IsFullBleedPage =>
        IsHomePage
        || Path.StartsWith("/data", StringComparison.OrdinalIgnoreCase)
        || Path.Equals("/organizations/discover", StringComparison.OrdinalIgnoreCase)
        || Path.Equals("/sensor-dashboard", StringComparison.OrdinalIgnoreCase);

    // Top-level pages render their own heading or rely on the active pill;
    // the divider + title is for pages one level in.
    private bool ShowTitleDivider =>
        Navbar.State.Title is not null
        && !IsHomePage
        && !NavLinks.Any(l => Path.Equals(l.Href, StringComparison.OrdinalIgnoreCase));

    private string UserInitial
    {
        get
        {
            var name = AuthState.CurrentUser?.DisplayName;
            return string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (AuthState.IsAuthenticated)
        {
            await NotificationService.InitializeAsync();
        }
    }

    [Event]
    private async Task OnAuthChanged(AuthChanged _)
    {
        if (AuthState.IsAuthenticated)
        {
            await NotificationService.InitializeAsync();
        }
    }

    [Event]
    private void OnNavigationChanged(NavigationChanged e)
    {
        if (_lastUri == e.State.Uri)
        {
            return;
        }

        _lastUri = e.State.Uri;
        _pageTransitionClass = e.State.Direction switch
        {
            NavigationDirection.Forward => "page-transition-forward",
            NavigationDirection.Back => "page-transition-back",
            _ => ""
        };
        _navigationKey = Guid.NewGuid().ToString();
    }

    [Event]
    private void OnNavbarChanged(NavbarChanged _) { }

    private string NavLinkClass(string match)
    {
        var isActive = match == "/"
            ? Path is "/" or ""
            : Path.StartsWith(match, StringComparison.OrdinalIgnoreCase);

        return isActive ? "ep-nav-link is-active" : "ep-nav-link";
    }

    private string SubnavLinkClass(string href) =>
        Path.Equals(href, StringComparison.OrdinalIgnoreCase) ? "ep-subnav-link is-active" : "ep-subnav-link";
}
