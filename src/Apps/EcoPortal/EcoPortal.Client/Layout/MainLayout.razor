@inherits StatefulLayoutComponent
@using EcoPortal.Client.Services
@inject NavigationManager Navigation
@inject PageNavigation PageNavigation
@inject ITabNavigationService Tabs

<EpShell>
    @if (IsFullBleedPage)
    {
        <div class="page-transition" @key="_navigationKey">
            @Body
        </div>
    }
    else
    {
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 px-4">
            <div class="page-transition" @key="_navigationKey">
                @Body
            </div>
        </MudContainer>
    }
</EpShell>

@code {
    // The signed-in user changed (login, logout, profile update). Published by
    // AuthStateService; anyone showing auth-derived chrome reacts through this record.
    public sealed record AuthChanged;

    private string _navigationKey = Guid.NewGuid().ToString();
    private string _lastUri = "";

    private string Path => new Uri(Navigation.Uri).AbsolutePath;

    private bool IsHomePage => Tabs.CurrentTab == NavigationTab.Home;

    // Pages that draw their own chrome get @Body with no container. The
    // organization workspace has its own layout and never renders here.
    private bool IsFullBleedPage =>
        IsHomePage
        || Path.StartsWith("/data", StringComparison.OrdinalIgnoreCase)
        || Path.Equals("/organizations/discover", StringComparison.OrdinalIgnoreCase)
        || Path.Equals("/sensor-dashboard", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await PageNavigation.InitializeAsync();
    }

    // A fresh key re-mounts the page so the slide-in runs once per navigation.
    [Event]
    private void OnNavigationChanged(NavigationChanged _)
    {
        if (_lastUri == Navigation.Uri)
            return;

        _lastUri = Navigation.Uri;
        _navigationKey = Guid.NewGuid().ToString();
    }
}
