@page "/categories"
@page "/categories/{Id:guid}"
@using EcoData.Wildlife.Contracts.Dtos
@inherits StatefulComponent
@inject ISpeciesCategoryHttpClient CategoryHttpClient
@inject ISpeciesHttpClient SpeciesHttpClient
@inject INativeNavbarManager Navbar
@inject NavigationManager NavigationManager
@inject ILocalizer L

<PageTitle>FaunaFinder — @L["Categories_PageTitle"]</PageTitle>

@if (Id is not null)
{
    @* Category Detail - Show species in this category *@
    <NuiPageLayout Title="@_categoryName" ParentPath="/categories">
        @if (_speciesLoadError is not null)
        {
            <MudAlert Severity="Severity.Error">@_speciesLoadError</MudAlert>
        }
        else if (LoadSpeciesInCategoryState.Result is null || LoadSpeciesInCategoryState.IsLoading)
        {
            @for (int i = 0; i < 8; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" Class="mb-2 rounded" />
            }
        }
        else if (LoadSpeciesInCategoryState.Result.Count == 0)
        {
            <NuiEmptyState Icon="@Icons.Material.Outlined.Pets"
                           Title="@L[CategoryDetailEmptyTitle]"
                           Description="@L[CategoryDetailEmptyDescription]" />
        }
        else
        {
            <NuiSectionHeader Title="@SpeciesCountHeading" />
            <MudList T="SpeciesDtoForList" Dense="true">
                @foreach (var species in LoadSpeciesInCategoryState.Result)
                {
                    <NuiListItem Title="@GetSpeciesName(species)"
                                 Subtitle="@species.ScientificName"
                                 Icon="@(species.IsFauna ? Icons.Material.Filled.Pets : Icons.Material.Filled.Park)"
                                 ShowChevron="true"
                                 OnClick="@(() => NavigateToSpecies(species.Id))">
                        <TrailingContent>
                            <NuiStatusBadge Status="@GetConservationStatus(species.GRank)"
                                            Text="@(species.GRank ?? "-")"
                                            Size="NuiStatusSize.Small" />
                        </TrailingContent>
                    </NuiListItem>
                }
            </MudList>
        }
    </NuiPageLayout>
}
else
{
    @* Categories List *@
    <NuiPageLayout Title="Categories">
        @if (_categoriesLoadError is not null)
        {
            <MudAlert Severity="Severity.Error">@_categoriesLoadError</MudAlert>
        }
        else if (LoadCategoriesState.Result is null)
        {
            @for (int i = 0; i < 6; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" Class="mb-2 rounded" />
            }
        }
        else if (LoadCategoriesState.Result.Count == 0)
        {
            <NuiEmptyState Icon="@Icons.Material.Outlined.Category"
                           Title="@L[CategoriesEmptyTitle]"
                           Description="@L[CategoriesEmptyDescription]" />
        }
        else
        {
            <MudList T="SpeciesCategoryDtoForList" Dense="true">
                @foreach (var category in LoadCategoriesState.Result)
                {
                    <NuiListItem Title="@GetCategoryName(category)"
                                 Subtitle="@category.Code"
                                 Icon="@GetCategoryIcon(category.Code)"
                                 ShowChevron="true"
                                 OnClick="@(() => NavigateToCategory(category.Id, category))">
                    </NuiListItem>
                }
            </MudList>
        }
    </NuiPageLayout>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    // Keys exposed as consts so the Razor attribute form (`Title="@L[Key]"`)
    // compiles without nested-quote issues.
    private const string CategoriesEmptyTitle = "Categories_Empty_Title";
    private const string CategoriesEmptyDescription = "Categories_Empty_Description";
    private const string CategoryDetailEmptyTitle = "CategoryDetail_Empty_Title";
    private const string CategoryDetailEmptyDescription = "CategoryDetail_Empty_Description";

    private string? _categoryName;
    private Guid? _loadedCategoryId;

    private string? _categoriesLoadError;
    private string? _speciesLoadError;

    private string SpeciesCountHeading =>
        L["CategoryDetail_SpeciesCount", LoadSpeciesInCategoryState.Result?.Count ?? 0];

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navbar.SetTitle(L["Nav_Categories"]);
        L.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        if (Id is null) Navbar.SetTitle(L["Nav_Categories"]);
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is { } id)
        {
            if (_loadedCategoryId == id) return;
            _loadedCategoryId = id;

            await LoadSpeciesInCategoryState.TryExecute();
        }
        else
        {
            _loadedCategoryId = null;
            if (LoadCategoriesState.Result is null && !LoadCategoriesState.IsLoading)
            {
                await LoadCategoriesState.TryExecute();
            }
        }
    }

    [Command]
    private async Task<IReadOnlyList<SpeciesCategoryDtoForList>?> LoadCategories(CancellationToken ct)
    {
        var result = await CategoryHttpClient.GetAllAsync(ct);
        if (result.TryPickT0(out var categories, out var error))
        {
            _categoriesLoadError = null;
            return categories;
        }
        _categoriesLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading categories.";
        return [];
    }

    [Command]
    private async Task<IReadOnlyList<SpeciesDtoForList>?> LoadSpeciesInCategory(CancellationToken ct)
    {
        var result = await SpeciesHttpClient.GetByCategoryAsync(_loadedCategoryId!.Value, ct);
        if (result.TryPickT0(out var species, out var error))
        {
            _speciesLoadError = null;
            return species;
        }
        _speciesLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading species.";
        return [];
    }

    public override void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
        base.Dispose();
    }

    private void NavigateToCategory(Guid categoryId, SpeciesCategoryDtoForList category)
    {
        _categoryName = GetCategoryName(category);
        Navbar.SetTitle(_categoryName);
        NavigationManager.NavigateTo($"/categories/{categoryId}");
    }

    private void NavigateToSpecies(Guid speciesId)
    {
        NavigationManager.NavigateTo($"/species/{speciesId}");
    }

    private static string GetCategoryName(SpeciesCategoryDtoForList category)
    {
        var englishName = category.Name.FirstOrDefault(n => n.Code == "en");
        return englishName?.Value ?? category.Name.FirstOrDefault()?.Value ?? category.Code;
    }

    private static string GetSpeciesName(SpeciesDtoForList species)
    {
        var englishName = species.CommonName.FirstOrDefault(n => n.Code == "en");
        return englishName?.Value ?? species.CommonName.FirstOrDefault()?.Value ?? species.ScientificName;
    }

    private static NuiStatusType GetConservationStatus(string? gRank)
    {
        if (string.IsNullOrEmpty(gRank)) return NuiStatusType.Inactive;

        return gRank.ToUpperInvariant() switch
        {
            "G1" or "G2" => NuiStatusType.Error,
            "G3" => NuiStatusType.Warning,
            "G4" or "G5" => NuiStatusType.Success,
            _ => NuiStatusType.Inactive
        };
    }

    private static string GetCategoryIcon(string code)
    {
        return code.ToLowerInvariant() switch
        {
            "bird" => Icons.Material.Filled.FlutterDash,
            "mammal" => Icons.Material.Filled.Pets,
            "reptile" => Icons.Material.Filled.Coronavirus,
            "amphibian" => Icons.Material.Filled.Water,
            "fish" => Icons.Material.Filled.Phishing,
            "invertebrate" => Icons.Material.Filled.BugReport,
            "plant" => Icons.Material.Filled.Park,
            "fern" => Icons.Material.Filled.Grass,
            _ => Icons.Material.Filled.Category
        };
    }
}
