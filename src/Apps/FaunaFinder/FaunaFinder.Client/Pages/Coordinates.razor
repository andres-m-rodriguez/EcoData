@page "/coordinates"
@inherits EcoDataComponent
@inject INavbarManager Navbar

<PageTitle>FaunaFinder | @L["Coordinates_PageTitle"]</PageTitle>

<div class="ff-coordinates-page">
    <MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
        <header class="ff-coordinates-head">
            <span class="ff-coordinates-eyebrow">@L["Rail_Heading"]</span>
            <h1 class="ff-coordinates-title">@L["Coordinates_Title"]</h1>
            <p class="ff-coordinates-lede">@L["Coordinates_Lede"]</p>
        </header>

        <section class="ff-coordinates-card">
            <CoordinatesTool />
        </section>
    </MudContainer>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navbar.SetTitle(L["Coordinates_PageTitle"]);
    }

    protected override void OnLanguageChanged() => Navbar.SetTitle(L["Coordinates_PageTitle"]);
}
