@page "/actions"
@page "/actions/{Code}"
@using EcoData.Wildlife.Contracts.Dtos
@using EcoData.Wildlife.Contracts.Parameters
@inherits StatefulComponent
@inject IFwsActionHttpClient ActionClient
@inject IConservationLinkHttpClient LinkClient
@inject ISpeciesHttpClient SpeciesHttpClient
@inject INativeNavbarManager Navbar
@inject NavigationManager NavigationManager
@inject ILocalizer L

<PageTitle>FaunaFinder — @L["Actions_PageTitle"]</PageTitle>

@if (Code is not null)
{
    @* Action detail — the NRCS practices that carry this action, and the species behind them *@
    <NuiPageLayout Title="@ActionTitle" ParentPath="/actions">
        @if (_actionsLoadError is not null)
        {
            <MudAlert Severity="Severity.Error">@_actionsLoadError</MudAlert>
        }
        else
        {
            @if (SelectedAction is { } action)
            {
                <MudPaper Elevation="0" Class="pa-4 pa-md-6 rounded-lg border-solid border mud-border-lines-default mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                            @action.Code
                        </MudChip>
                        <MudText Typo="Typo.h6">@Locale.Resolve(action.Name, action.Code)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ActionDetail_Subline"]</MudText>
                </MudPaper>
            }

            <MudPaper Elevation="0" Class="pa-4 pa-md-6 rounded-lg border-solid border mud-border-lines-default mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Agriculture" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@L["ActionDetail_Practices_Heading"]</MudText>
                    <MudSpacer />
                    @if (LoadPracticesState.Result is { Count: > 0 } practices)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@practices.Count</MudText>
                    }
                </MudStack>

                @if (_practicesLoadError is not null)
                {
                    <MudAlert Severity="Severity.Error">@_practicesLoadError</MudAlert>
                }
                else if (LoadPracticesState.Result is null || LoadPracticesState.IsLoading)
                {
                    @* Also while loading: the component is reused across /actions/{code},
                       so a stale result would belong to the previous action. *@
                    @for (int i = 0; i < 4; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="64px" Class="mb-2 rounded" />
                    }
                }
                else if (LoadPracticesState.Result.Count == 0)
                {
                    <NuiEmptyState Icon="@Icons.Material.Outlined.Agriculture"
                                   Title="@L[ActionPracticesEmptyTitle]"
                                   Description="@L[ActionPracticesEmptyDescription]" />
                }
                else
                {
                    <MudList T="ActionPracticeDtoForList" Dense="true">
                        @foreach (var practice in LoadPracticesState.Result)
                        {
                            <NuiListItem Title="@Locale.Resolve(practice.NrcsPractice.Name, practice.NrcsPractice.Code)"
                                         Subtitle="@L["ActionDetail_PracticeCode", practice.NrcsPractice.Code]"
                                         Icon="@Icons.Material.Filled.Agriculture"
                                         ShowChevron="true"
                                         OnClick="@(() => NavigateToPractice(practice.NrcsPractice.Code))">
                                <TrailingContent>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @L["ActionDetail_PracticeSpeciesCount", practice.SpeciesCount]
                                    </MudText>
                                </TrailingContent>
                            </NuiListItem>
                        }
                    </MudList>
                }
            </MudPaper>

            <NuiSectionHeader Title="@(LoadSpeciesCountState.Result is { } speciesCount && !LoadSpeciesCountState.IsLoading
                                        ? L["ActionDetail_SpeciesCount", speciesCount]
                                        : L["ActionDetail_Species_Heading"])" />

            <NuiVirtualizedGrid @key="Code"
                                TItem="SpeciesDtoForList"
                                TParams="SpeciesParameters"
                                ItemsProvider="FetchSpecies"
                                ParametersBuilder="BuildSpeciesParameters"
                                CursorSelector="@(s => s.Id)"
                                ItemSize="72"
                                OverscanCount="4">
                <LoadingTemplate>
                    @for (int i = 0; i < 8; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" Class="mb-2 rounded" />
                    }
                </LoadingTemplate>
                <EmptyTemplate>
                    <NuiEmptyState Icon="@Icons.Material.Outlined.Pets"
                                   Title="@L[ActionDetailEmptyTitle]"
                                   Description="@L[ActionDetailEmptyDescription]" />
                </EmptyTemplate>
                <ItemTemplate Context="species">
                    <NuiListItem Title="@GetSpeciesName(species)"
                                 Subtitle="@species.ScientificName"
                                 Icon="@(species.IsFauna ? Icons.Material.Filled.Pets : Icons.Material.Filled.Park)"
                                 ShowChevron="true"
                                 OnClick="@(() => NavigateToSpecies(species.Id))">
                        <TrailingContent>
                            <NuiStatusBadge Status="@GetConservationStatus(species.GRank)"
                                            Text="@(species.GRank ?? "-")"
                                            Size="NuiStatusSize.Small" />
                        </TrailingContent>
                    </NuiListItem>
                </ItemTemplate>
                <PlaceholderTemplate>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" Class="mb-2 rounded" />
                </PlaceholderTemplate>
            </NuiVirtualizedGrid>
        }
    </NuiPageLayout>
}
else
{
    @* Actions list *@
    <div class="ff-page aa-page">
        @* A failed load returns an empty list, which would read as a real zero. *@
        <ActionEditorialHero ActionCount="@(_actionsLoadError is null ? LoadActionsState.Result?.Count : null)" />

        @if (_actionsLoadError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-6">@_actionsLoadError</MudAlert>
        }
        else
        {
            <section class="aa-list">
                @if (LoadActionsState.Result is null)
                {
                    @for (int i = 0; i < 6; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" Class="mb-2 rounded" />
                    }
                }
                else if (LoadActionsState.Result.Count == 0)
                {
                    <NuiEmptyState Icon="@Icons.Material.Outlined.Gavel"
                                   Title="@L[ActionsEmptyTitle]"
                                   Description="@L[ActionsEmptyDescription]" />
                }
                else
                {
                    <MudList T="FwsActionDtoForList" Dense="true">
                        @foreach (var action in LoadActionsState.Result)
                        {
                            <NuiListItem Title="@Locale.Resolve(action.Name, action.Code)"
                                         Subtitle="@action.Code"
                                         Icon="@Icons.Material.Filled.Gavel"
                                         ShowChevron="true"
                                         OnClick="@(() => NavigateToAction(action))">
                            </NuiListItem>
                        }
                    </MudList>
                }
            </section>
        }
    </div>
}

@code {
    [Parameter] public string? Code { get; set; }

    [CascadingParameter] public LocaleContext Locale { get; set; } = LocaleContext.English;

    private const int SpeciesPageSize = 24;

    // Keys exposed as consts so the Razor attribute form (`Title="@L[Key]"`)
    // compiles without nested-quote issues.
    private const string ActionsEmptyTitle = "Actions_Empty_Title";
    private const string ActionsEmptyDescription = "Actions_Empty_Description";
    private const string ActionPracticesEmptyTitle = "ActionDetail_Practices_Empty_Title";
    private const string ActionPracticesEmptyDescription = "ActionDetail_Practices_Empty_Description";
    private const string ActionDetailEmptyTitle = "ActionDetail_Empty_Title";
    private const string ActionDetailEmptyDescription = "ActionDetail_Empty_Description";

    private string? _loadedCode;
    private string? _actionsLoadError;
    private string? _practicesLoadError;

    private FwsActionDtoForList? SelectedAction =>
        Code is null
            ? null
            : (LoadActionsState.Result ?? []).FirstOrDefault(
                a => string.Equals(a.Code, Code, StringComparison.OrdinalIgnoreCase));

    // Falls back to the raw code so the navbar has a title while the list loads
    // or when the route was opened directly.
    private string? ActionTitle =>
        SelectedAction is { } action ? $"{action.Code} — {Locale.Resolve(action.Name, action.Code)}" : Code;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navbar.SetTitle(L["Nav_Actions"]);
        L.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        if (Code is null) Navbar.SetTitle(L["Nav_Actions"]);
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Both routes need the action list: the detail resolves its heading
        // from it, since the route carries only the code.
        if (LoadActionsState.Result is null && !LoadActionsState.IsLoading)
        {
            await LoadActionsState.TryExecute();
        }

        if (Code is { } code)
        {
            if (_loadedCode == code) return;
            _loadedCode = code;

            Navbar.SetTitle(ActionTitle ?? code);
            await LoadPracticesState.TryExecute();
            await LoadSpeciesCountState.TryExecute();
        }
        else
        {
            _loadedCode = null;
        }
    }

    [Command]
    private async Task<IReadOnlyList<FwsActionDtoForList>?> LoadActions(CancellationToken ct)
    {
        var result = await ActionClient.GetAllAsync(ct);
        if (result.TryPickT0(out var actions, out var error))
        {
            _actionsLoadError = null;
            return actions;
        }
        _actionsLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading conservation actions.";
        return [];
    }

    [Command]
    private async Task<IReadOnlyList<ActionPracticeDtoForList>?> LoadPractices(CancellationToken ct)
    {
        var result = await LinkClient.GetPracticesByActionAsync(_loadedCode!, ct);
        if (result.TryPickT0(out var practices, out var error))
        {
            _practicesLoadError = null;
            return practices;
        }
        _practicesLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading conservation practices.";
        return [];
    }

    private SpeciesParameters BuildSpeciesParameters(Guid? cursor) =>
        new(
            PageSize: SpeciesPageSize,
            Cursor: cursor,
            FwsActionCodes: [Code!]
        );

    private IAsyncEnumerable<SpeciesDtoForList> FetchSpecies(
        SpeciesParameters parameters,
        CancellationToken ct
    ) => SpeciesHttpClient.GetSpeciesAsync(parameters, ct);

    // The list pages through species itself; this is only the heading tally.
    [Command]
    private async Task<int?> LoadSpeciesCount(CancellationToken ct)
    {
        var result = await SpeciesHttpClient.GetCountAsync(
            new SpeciesParameters(FwsActionCodes: [_loadedCode!]),
            ct
        );
        return result.TryPickT0(out var count, out _) ? count : null;
    }

    public override void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
        base.Dispose();
    }

    private void NavigateToAction(FwsActionDtoForList action)
    {
        Navbar.SetTitle($"{action.Code} — {Locale.Resolve(action.Name, action.Code)}");
        NavigationManager.NavigateTo($"/actions/{action.Code}");
    }

    private void NavigateToPractice(string practiceCode)
    {
        NavigationManager.NavigateTo($"/practices/{practiceCode}");
    }

    private void NavigateToSpecies(Guid speciesId)
    {
        NavigationManager.NavigateTo($"/species/{speciesId}");
    }

    private string GetSpeciesName(SpeciesDtoForList species) =>
        Locale.Resolve(species.CommonName, species.ScientificName);

    private static NuiStatusType GetConservationStatus(string? gRank)
    {
        if (string.IsNullOrEmpty(gRank)) return NuiStatusType.Inactive;

        return gRank.ToUpperInvariant() switch
        {
            "G1" or "G2" => NuiStatusType.Error,
            "G3" => NuiStatusType.Warning,
            "G4" or "G5" => NuiStatusType.Success,
            _ => NuiStatusType.Inactive
        };
    }
}
