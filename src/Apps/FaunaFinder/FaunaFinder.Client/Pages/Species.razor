@page "/species"
@page "/species/{Id:guid}"
@using EcoData.Wildlife.Contracts
@using EcoData.Wildlife.Contracts.Dtos
@using EcoData.Wildlife.Contracts.Parameters
@using EcoData.Locations.Contracts.Dtos
@using EcoData.Locations.Application.Client
@using EcoData.NativeUi.Components.NativeNavbar
@using FaunaFinder.Client.Services.FieldNotebook
@inherits StatefulComponent
@inject ISpeciesHttpClient SpeciesHttpClient
@inject ISpeciesCategoryHttpClient SpeciesCategoryHttpClient
@inject IMunicipalityHttpClient MunicipalityHttpClient
@inject INativeNavbarManager Navbar
@inject NavigationManager NavigationManager
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport
@inject IFieldNotebook Notebook
@inject ILocalizer L

<PageTitle>@L["Species_PageTitle"]</PageTitle>

@if (Id is not null)
{
    <NuiPageLayout Title="@(LoadDetailState.IsLoading ? null : LoadDetailState.Result?.ScientificName)" ParentPath="/species">
        @if (_detailLoadError is not null)
        {
            <MudAlert Severity="Severity.Error">@_detailLoadError</MudAlert>
        }
        else if (LoadDetailState.IsLoading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" Class="mb-4 rounded-lg" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Class="mb-2" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" />
        }
        else if (LoadDetailState.Result is { } detail)
        {
            @* The hero owns the visible heading and is not ours to change, so the
               star rides in its top-right gutter rather than in the heading row. *@
            <div class="ff-hero-slot">
                <SpeciesHero Species="detail" />

                <div class="ff-hero-save">
                    <MudTooltip Text="@SaveLabel">
                        <MudIconButton Icon="@SaveIcon"
                                       Color="@(_isSaved ? Color.Warning : Color.Default)"
                                       aria-label="@SaveLabel"
                                       aria-pressed="@(_isSaved ? "true" : "false")"
                                       OnClick="@(() => ToggleSaved(detail))" />
                    </MudTooltip>
                </div>
            </div>

            <MudPaper Elevation="0" Class="pa-4 pa-md-6 rounded-lg border-solid border mud-border-lines-default mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.LocationCity" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@L["SpeciesDetail_Municipalities_Heading"]</MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @detail.MunicipalityIds.Count
                    </MudText>
                </MudStack>

                @if (_municipalitiesLoadError is not null)
                {
                    <MudAlert Severity="Severity.Error">@_municipalitiesLoadError</MudAlert>
                }
                else if (LoadMunicipalitiesState.Result is null || LoadMunicipalitiesState.IsLoading)
                {
                    <MudGrid Spacing="2">
                        @for (var i = 0; i < Math.Min(6, detail.MunicipalityIds.Count); i++)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="rounded-lg" />
                            </MudItem>
                        }
                    </MudGrid>
                }
                else if (LoadMunicipalitiesState.Result.Count == 0)
                {
                    <NuiEmptyState Icon="@Icons.Material.Outlined.LocationOff"
                                   Title="@L[SpeciesDetailMunicipalitiesEmptyTitle]"
                                   Description="@L[SpeciesDetailMunicipalitiesEmptyDescription]" />
                }
                else
                {
                    <MudGrid Spacing="2">
                        @foreach (var muni in LoadMunicipalitiesState.Result)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MunicipalityCard Municipality="muni"
                                                  OnClick="@(m => NavigateToMunicipality(m.Id))" />
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudPaper>

            <ConservationLinksPanel SpeciesId="detail.Id" />
        }
        else
        {
            <NuiEmptyState Icon="@Icons.Material.Outlined.SearchOff"
                           Title="@L[SpeciesDetailNotFoundTitle]"
                           Description="@L[SpeciesDetailNotFoundDescription]" />
        }
    </NuiPageLayout>
}
else
{
    <div class="ff-page">
        @if ((_statsLoadError ?? _facetsLoadError ?? _taxaCountsLoadError) is { } listLoadError)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@listLoadError</MudAlert>
        }

        <SpeciesEditorialHero Stats="@LoadStatsState.Result" />

        <SpeciesStatsRow Stats="@LoadStatsState.Result" />

        <SpeciesFeaturedRow OnSpeciesClick="NavigateToSpeciesDetail" />

        <SpeciesToolbar Filter="@_filter"
                        FilterChanged="OnFilterChanged"
                        SearchText="@_search"
                        SearchTextChanged="OnSearchChanged"
                        Sort="@_sort"
                        SortChanged="OnSortChanged"
                        Stats="@LoadStatsState.Result"
                        OnFilterClick="OpenFilterDialog" />

        <SpeciesGrid Filter="@_filter"
                     Search="@_search"
                     Sort="@_sort"
                     OnSpeciesClick="NavigateToSpeciesDetail" />
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    // Keys held as consts so they can appear in Razor attribute forms
    // (`Title="@L[SomeKey]"`) without tripping the nested-quote rule.
    private const string SpeciesDetailMunicipalitiesEmptyTitle = "SpeciesDetail_Municipalities_Empty_Title";
    private const string SpeciesDetailMunicipalitiesEmptyDescription = "SpeciesDetail_Municipalities_Empty_Description";
    private const string SpeciesDetailNotFoundTitle = "SpeciesDetail_NotFound_Title";
    private const string SpeciesDetailNotFoundDescription = "SpeciesDetail_NotFound_Description";

    [CascadingParameter] public LocaleContext Locale { get; set; } = LocaleContext.English;

    private Guid? _loadedDetailId;

    // The visit is filed once per species, not once per detail load — the id
    // sticks around so a re-run of the notebook command can't double-file it.
    private Guid? _recordedVisitId;
    private bool _isSaved;

    private string? _detailLoadError;
    private string? _municipalitiesLoadError;
    private string? _statsLoadError;
    private string? _facetsLoadError;
    private string? _taxaCountsLoadError;

    private SpeciesFilterResult _filter = SpeciesFilterResult.Empty;
    private string? _search;
    private SpeciesSort _sort = SpeciesSort.ScientificNameAsc;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navbar.SetTitle(L["Nav_Species"]);
        L.LanguageChanged += OnLanguageChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is { } id)
        {
            if (_loadedDetailId == id) return;
            _loadedDetailId = id;
            _detailLoadError = null;
            _isSaved = false;

            await LoadDetailState.TryExecute();
            if (LoadDetailState.Result is not null)
            {
                _ = LoadMunicipalitiesState.TryExecute();
                _ = SyncNotebookState.TryExecute();
            }
        }
        else
        {
            _loadedDetailId = null;
        }
    }

    [Command, RunOnLoad]
    private async Task<SpeciesStatsDto?> LoadStats(CancellationToken ct)
    {
        var result = await SpeciesHttpClient.GetStatsAsync(ct);
        if (result.TryPickT0(out var stats, out var error))
        {
            _statsLoadError = null;
            return stats;
        }
        _statsLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading species stats.";
        return null;
    }

    [Command, RunOnLoad]
    private async Task<SpeciesFacetsDto?> LoadFacets(CancellationToken ct)
    {
        var result = await SpeciesHttpClient.GetFacetsAsync(BuildFacetParameters(), ct);
        if (result.TryPickT0(out var facets, out var error))
        {
            _facetsLoadError = null;
            return facets;
        }
        _facetsLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading filters.";
        return null;
    }

    [Command, RunOnLoad]
    private async Task<IReadOnlyList<TaxonFacetDto>?> LoadTaxaCounts(CancellationToken ct)
    {
        var result = await SpeciesCategoryHttpClient.GetCountsAsync(ct);
        if (result.TryPickT0(out var counts, out var error))
        {
            _taxaCountsLoadError = null;
            return counts;
        }
        _taxaCountsLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading category counts.";
        return [];
    }

    [Command]
    private async Task<SpeciesDtoForDetail?> LoadDetail(CancellationToken ct)
    {
        var result = await SpeciesHttpClient.GetByIdAsync(_loadedDetailId!.Value, ct);
        if (result.TryPickT0(out var detail, out var error))
        {
            _detailLoadError = null;

            var name = GetSpeciesName(detail);
            Navbar.SetTitle(name);

            // Put the animal beside its own name in the mobile bar. Alt is
            // empty on purpose: the title next to it already says the name,
            // and a screen reader shouldn't hear it twice. The mobile slot
            // drops the portrait on navigation, so there is nothing to undo.
            Bus.Publish(new FfMobileTitle.Avatar(
                detail.HasProfileImage ? $"/wildlife/species/{detail.Id}/image" : null,
                Alt: string.Empty));

            return detail;
        }
        // A missing species keeps the dedicated not-found empty state.
        _detailLoadError = error.StatusCode switch
        {
            404 => null,
            0 => "Couldn't reach the server.",
            _ => error.Message ?? "Something went wrong while loading this species."
        };
        return null;
    }

    [Command]
    private async Task<IReadOnlyList<MunicipalityDtoForList>?> LoadMunicipalities(CancellationToken ct)
    {
        var ids = LoadDetailState.Result?.MunicipalityIds ?? [];
        var result = await MunicipalityHttpClient.GetByIdsAsync(ids, ct);
        if (result.TryPickT0(out var municipalities, out var error))
        {
            _municipalitiesLoadError = null;
            return municipalities;
        }
        _municipalitiesLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading municipalities.";
        return [];
    }

    // Notebook chrome: reads the pin state and files the visit. It runs beside
    // the detail rather than in front of it — nothing rendered waits on it.
    [Command]
    private async Task SyncNotebook(CancellationToken ct)
    {
        if (LoadDetailState.Result is not { } detail) return;

        _isSaved = await Notebook.IsSavedAsync(NotebookEntryKind.Species, detail.Id, ct);

        if (_recordedVisitId == detail.Id) return;
        _recordedVisitId = detail.Id;
        await Notebook.RecordVisitAsync(ToNotebookEntry(detail), ct);
    }

    private async Task ToggleSaved(SpeciesDtoForDetail detail)
    {
        _isSaved = await Notebook.ToggleSavedAsync(ToNotebookEntry(detail));
    }

    private string SaveLabel => _isSaved ? L["Notebook_Unsave"] : L["Notebook_Save"];

    private string SaveIcon => _isSaved
        ? Icons.Material.Filled.Star
        : Icons.Material.Outlined.StarBorder;

    // The labels are a snapshot, so they are resolved in the reader's current
    // language at the moment the entry is written.
    private NotebookEntry ToNotebookEntry(SpeciesDtoForDetail detail) => new(
        NotebookEntryKind.Species,
        detail.Id,
        Locale.Resolve(detail.CommonName, fallback: detail.ScientificName),
        detail.ScientificName,
        detail.IucnStatus?.ToString(),
        DateTimeOffset.UtcNow,
        detail.HasProfileImage
    );

    private SpeciesParameters BuildFacetParameters() => new(
        Search: string.IsNullOrWhiteSpace(_search) ? null : _search,
        EndemicStatuses: _filter.EndemicOnly ? [EndemicStatus.Endemic] : null,
        HasProfileImage: _filter.HasPhoto ? true : null,
        IucnStatuses: _filter.IucnStatuses.Count > 0 ? _filter.IucnStatuses.ToArray() : null,
        TaxonCodes: _filter.TaxonCodes.Count > 0 ? _filter.TaxonCodes.ToArray() : null,
        MinMunicipalityCount: _filter.MinMunicipalityCount,
        ObservedSinceUtc: _filter.ObservedRecently ? DateTimeOffset.UtcNow.AddYears(-1) : null
    );

    private void OnFilterChanged(SpeciesFilterResult filter)
    {
        _filter = filter;
        _ = LoadFacetsState.TryExecute();
    }

    private void OnSearchChanged(string? value)
    {
        _search = value;
        _ = LoadFacetsState.TryExecute();
    }

    private void OnSortChanged(SpeciesSort sort)
    {
        _sort = sort;
    }

    private async Task OpenFilterDialog()
    {
        var breakpoint = await Viewport.GetCurrentBreakpointAsync();
        var isMobile = breakpoint is Breakpoint.Xs or Breakpoint.Sm;

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            FullScreen = isMobile,
        };

        var parameters = new DialogParameters<SpeciesFilterDialog>
        {
            { x => x.Initial, _filter },
            { x => x.Facets, LoadFacetsState.Result },
            { x => x.TaxaCounts, LoadTaxaCountsState.Result }
        };

        var dialog = await Dialogs.ShowAsync<SpeciesFilterDialog>("Filters", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: SpeciesFilterResult next })
        {
            OnFilterChanged(next);
        }
    }

    private void NavigateToSpeciesDetail(SpeciesDtoForList species) =>
        NavigationManager.NavigateTo($"/species/{species.Id}");

    private void NavigateToMunicipality(Guid municipalityId) =>
        NavigationManager.NavigateTo($"/municipalities/{municipalityId}");

    private void OnLanguageChanged()
    {
        // Nav title needs refreshing since we seeded it from L in OnInitialized.
        Navbar.SetTitle(Id is null ? L["Nav_Species"] : Navbar.State.Title ?? L["Nav_Species"]);
        InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
        base.Dispose();
    }

    private static string GetSpeciesName(SpeciesDtoForDetail species)
    {
        var englishName = species.CommonName.FirstOrDefault(n => n.Code == "en");
        return englishName?.Value ?? species.CommonName.FirstOrDefault()?.Value ?? species.ScientificName;
    }
}
