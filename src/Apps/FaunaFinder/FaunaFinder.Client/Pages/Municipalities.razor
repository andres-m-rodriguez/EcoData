@page "/municipalities"
@page "/municipalities/{Id:guid}"
@using EcoData.Locations.Application.Client
@using EcoData.Locations.Contracts.Dtos
@using EcoData.Locations.Contracts.Parameters
@using EcoData.Wildlife.Application.Client
@using EcoData.Wildlife.Contracts.Dtos
@using EcoData.Wildlife.Contracts.Parameters
@using FaunaFinder.Client.Components.Municipalities
@using FaunaFinder.Client.Services.FieldNotebook
@inherits StatefulComponent
@inject IMunicipalityHttpClient MunicipalityClient
@inject ISpeciesHttpClient SpeciesClient
@inject INavbarManager Navbar
@inject NavigationManager NavigationManager
@inject IFieldNotebook Notebook
@inject ILocalizer L

<PageTitle>@L["Muni_PageTitle"]</PageTitle>

@if (Id is not null)
{
    <NuiPageLayout Title="@(LoadDetailState.IsLoading ? null : LoadDetailState.Result?.Name)" ParentPath="/municipalities">
        @if (_detailLoadError is not null)
        {
            <MudAlert Severity="Severity.Error">@_detailLoadError</MudAlert>
        }
        else if (LoadDetailState.IsLoading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" Class="mb-4 rounded-lg" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Class="mb-2" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" />
        }
        else if (LoadDetailState.Result is { } detail)
        {
            <MudPaper Elevation="0" Class="pa-4 pa-md-6 rounded-lg border-solid border mud-border-lines-default mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mm-detail-head">
                    <MudText Typo="Typo.h5" GutterBottom="true">@detail.Name</MudText>
                    <MudSpacer />
                    <MudTooltip Text="@SaveLabel">
                        <MudIconButton Icon="@SaveIcon"
                                       Color="@(_isSaved ? Color.Warning : Color.Default)"
                                       aria-label="@SaveLabel"
                                       aria-pressed="@(_isSaved ? "true" : "false")"
                                       OnClick="@(() => ToggleSaved(detail))" />
                    </MudTooltip>
                </MudStack>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">
                    @L["MuniDetail_Subline", detail.StateName, detail.CountyFipsCode]
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["MuniDetail_Centroid",
                        detail.CentroidLatitude.ToString("0.0000"),
                        Math.Abs(detail.CentroidLongitude).ToString("0.0000")]
                </MudText>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4 pa-md-6 rounded-lg border-solid border mud-border-lines-default">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Pets" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@L["MuniDetail_Species_Heading"]</MudText>
                    <MudSpacer />
                    @if (LoadDetailSpeciesCountState.Result is { } speciesCount and > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @speciesCount
                        </MudText>
                    }
                </MudStack>

                <SpeciesGrid MunicipalityId="@Id"
                             EmptyTitleKey="@MuniDetailSpeciesEmptyTitle"
                             EmptyDescriptionKey="@MuniDetailSpeciesEmptyDescription"
                             OnSpeciesClick="@(s => NavigationManager.NavigateTo($"/species/{s.Id}"))" />
            </MudPaper>
        }
        else
        {
            <NuiEmptyState Icon="@Icons.Material.Outlined.SearchOff"
                           Title="@L[MuniDetailNotFoundTitle]"
                           Description="@L[MuniDetailNotFoundDescription]" />
        }
    </NuiPageLayout>
}
else
{
    <div class="ff-page mm-page">
        <MunicipalityEditorialHero Stats="@LoadStatsState.Result" />

        <MunicipalityStatsRow Stats="@LoadStatsState.Result" />

        @if ((_statsLoadError ?? _municipalitiesLoadError) is { } listLoadError)
        {
            <MudAlert Severity="Severity.Error">@listLoadError</MudAlert>
        }

        @* Mobile tab toggle — radio-input driven, no JS. Inputs must live as
           siblings of .mm-tabs and .mm-layout so `:checked ~` can target them. *@
        <input type="radio" name="mm-tab" id="mm-tab-map" class="mm-tab-input" checked />
        <input type="radio" name="mm-tab" id="mm-tab-list" class="mm-tab-input" />

        <nav class="mm-tabs" role="tablist" aria-label="Municipios view">
            <label for="mm-tab-map" class="mm-tab" role="tab">
                <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" />
                @L["Muni_Tab_Map"]
            </label>
            <label for="mm-tab-list" class="mm-tab" role="tab">
                <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" />
                @L["Muni_Tab_List"]
                <span class="count">@(_municipalities?.Count ?? 0)</span>
            </label>
        </nav>

        <section class="mm-layout">
            <MunicipalityList Municipalities="@_municipalities"
                              Counts="@_countsMap"
                              SelectedId="@_selected?.Id"
                              OnSelected="HandleSelected"
                              OnDetails="HandleViewDetails" />

            <MunicipalityMap Municipalities="@_municipalities"
                             Counts="@_countsMap"
                             SelectedMunicipality="@_selected"
                             OnSelected="HandleSelected"
                             OnCleared="HandleCleared"
                             OnViewDetails="HandleViewDetails" />
        </section>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    // Keys held as consts so they can appear in Razor attribute forms
    // (`Title="@L[SomeKey]"`) without tripping the nested-quote rule.
    private const string MuniDetailSpeciesEmptyTitle = "MuniDetail_Species_Empty_Title";
    private const string MuniDetailSpeciesEmptyDescription = "MuniDetail_Species_Empty_Description";
    private const string MuniDetailNotFoundTitle = "MuniDetail_NotFound_Title";
    private const string MuniDetailNotFoundDescription = "MuniDetail_NotFound_Description";

    private IReadOnlyList<MunicipalityDtoForList>? _municipalities;
    private IReadOnlyDictionary<Guid, int>? _countsMap;

    private MunicipalityDtoForList? _selected;

    private Guid? _loadedDetailId;

    // The visit is filed once per municipality, not once per detail load — the
    // id sticks around so a re-run of the notebook command can't double-file it.
    private Guid? _recordedVisitId;
    private bool _isSaved;

    private string? _statsLoadError;
    private string? _municipalitiesLoadError;
    private string? _detailLoadError;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navbar.SetTitle(L["Nav_Municipios"]);
        L.LanguageChanged += OnLanguageChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is { } id)
        {
            if (_loadedDetailId == id) return;
            _loadedDetailId = id;
            _detailLoadError = null;
            _isSaved = false;

            await Task.WhenAll(
                LoadDetailState.TryExecute(),
                LoadDetailSpeciesCountState.TryExecute()
            );

            if (LoadDetailState.Result is not null)
            {
                _ = SyncNotebookState.TryExecute();
            }
        }
        else
        {
            _loadedDetailId = null;
        }
    }

    [Command, RunOnLoad]
    private async Task<SpeciesStatsDto?> LoadStats(CancellationToken ct)
    {
        var result = await SpeciesClient.GetStatsAsync(ct);
        if (result.TryPickT0(out var stats, out var error))
        {
            _statsLoadError = null;
            return stats;
        }
        _statsLoadError = error.StatusCode == 0
            ? "Couldn't reach the server."
            : error.Message ?? "Something went wrong while loading species stats.";
        return null;
    }

    [Command, RunOnLoad]
    private async Task LoadMunicipalities(CancellationToken ct)
    {
        _municipalitiesLoadError = null;

        // Run the list stream + count fetch in parallel.
        var countsTask = SpeciesClient.GetCountsByMunicipalityAsync(ct);

        var collected = new List<MunicipalityDtoForList>();
        try
        {
            await foreach (var m in MunicipalityClient.GetMunicipalitiesAsync(
                               new MunicipalityParameters(PageSize: 200, StateCode: "PR"),
                               ct))
            {
                collected.Add(m);
            }
        }
        catch (HttpRequestException e)
        {
            // The list stream has no error channel — the transport exception is the signal.
            _municipalitiesLoadError = e.StatusCode is null
                ? "Couldn't reach the server."
                : "Something went wrong while loading municipalities.";
            return;
        }

        var countsResult = await countsTask;
        if (!countsResult.TryPickT0(out var counts, out var countsError))
        {
            _municipalitiesLoadError = countsError.StatusCode == 0
                ? "Couldn't reach the server."
                : countsError.Message ?? "Something went wrong while loading species counts.";
            _countsMap = new Dictionary<Guid, int>();
            _municipalities = collected;
            return;
        }

        _countsMap = counts.ToDictionary(c => c.MunicipalityId, c => c.Count);
        _municipalities = collected;
    }

    [Command]
    private async Task<MunicipalityDtoForDetail?> LoadDetail(CancellationToken ct)
    {
        var result = await MunicipalityClient.GetByIdAsync(_loadedDetailId!.Value, ct);
        if (result.TryPickT0(out var detail, out var error))
        {
            _detailLoadError = null;
            Navbar.SetTitle(detail.Name);
            return detail;
        }
        // A missing municipality keeps the dedicated not-found empty state.
        _detailLoadError = error.StatusCode switch
        {
            404 => null,
            0 => "Couldn't reach the server.",
            _ => error.Message ?? "Something went wrong while loading this municipality."
        };
        return null;
    }

    // The grid pages through species itself; this is only the heading tally.
    [Command]
    private async Task<int?> LoadDetailSpeciesCount(CancellationToken ct)
    {
        var result = await SpeciesClient.GetCountAsync(
            new SpeciesParameters(MunicipalityId: _loadedDetailId!.Value),
            ct
        );
        return result.TryPickT0(out var count, out _) ? count : null;
    }

    // Notebook chrome: reads the pin state and files the visit. It runs beside
    // the detail rather than in front of it — nothing rendered waits on it.
    [Command]
    private async Task SyncNotebook(CancellationToken ct)
    {
        if (LoadDetailState.Result is not { } detail) return;

        _isSaved = await Notebook.IsSavedAsync(NotebookEntryKind.Municipality, detail.Id, ct);

        if (_recordedVisitId == detail.Id) return;
        _recordedVisitId = detail.Id;
        await Notebook.RecordVisitAsync(ToNotebookEntry(detail), ct);
    }

    private async Task ToggleSaved(MunicipalityDtoForDetail detail)
    {
        _isSaved = await Notebook.ToggleSavedAsync(ToNotebookEntry(detail));
    }

    private string SaveLabel => _isSaved ? L["Notebook_Unsave"] : L["Notebook_Save"];

    private string SaveIcon => _isSaved
        ? Icons.Material.Filled.Star
        : Icons.Material.Outlined.StarBorder;

    private static NotebookEntry ToNotebookEntry(MunicipalityDtoForDetail detail) => new(
        NotebookEntryKind.Municipality,
        detail.Id,
        detail.Name,
        null,
        null,
        DateTimeOffset.UtcNow
    );

    private Task HandleSelected(MunicipalityDtoForList muni)
    {
        _selected = muni;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleCleared()
    {
        _selected = null;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleViewDetails(MunicipalityDtoForList muni)
    {
        NavigationManager.NavigateTo($"/municipalities/{muni.Id}");
        return Task.CompletedTask;
    }

    private void OnLanguageChanged()
    {
        if (Id is null) Navbar.SetTitle(L["Nav_Municipios"]);
        InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
        base.Dispose();
    }
}
