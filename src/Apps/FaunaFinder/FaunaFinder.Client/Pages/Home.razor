@page "/"
@using EcoData.Common.Problems.Contracts
@using EcoData.Locations.Contracts.Dtos
@using EcoData.Locations.Contracts.Parameters
@using EcoData.Wildlife.Contracts.Dtos
@inherits StatefulComponent
@inject ISpeciesHttpClient SpeciesClient
@inject ISpeciesCategoryHttpClient SpeciesCategoryClient
@inject IMunicipalityHttpClient MunicipalityClient
@inject NavigationManager NavigationManager
@inject ILocalizer L

<PageTitle>FaunaFinder — @L["Nav_Home"]</PageTitle>

<div class="ff-page ff-home">
    <header class="ff-home-greeting">
        <h1>@Greeting</h1>
        <p>@GreetingSubline</p>
    </header>

    @if (LoadError is { } loadError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@loadError</MudAlert>
    }

    <FfQuickPickRow>
        <FfQuickPick Label="@L[HomeQuickMap]" Icon="@Icons.Material.Filled.Map" Href="/map" Tone="0" />
        <FfQuickPick Label="@L[HomeQuickSpecies]" Icon="@Icons.Material.Filled.Pets" Href="/species" Tone="1" />
        <FfQuickPick Label="@L[HomeQuickEndemic]" Icon="@Icons.Material.Filled.Star" Href="/species" Tone="2" />
        <FfQuickPick Label="@L[HomeQuickThreatened]" Icon="@Icons.Material.Filled.Warning" Href="/species" Tone="3" />
    </FfQuickPickRow>

    @if (NothingToShow)
    {
        <div class="ff-home-empty">
            <NuiEmptyState Icon="@Icons.Material.Outlined.Pets"
                           Title="@L[HomeEmptyTitle]"
                           Description="@L[HomeEmptyDescription]" />
        </div>
    }
    else
    {
        @* --- Featured species -------------------------------------------- *@
        @if (LoadFeaturedState.Result is not { Count: 0 })
        {
            <FfShelf Title="@L[HomeFeaturedHeading]"
                     Subtitle="@L[HomeFeaturedSub]"
                     ActionLabel="@L[HomeShowAll]"
                     ActionHref="/species">
                @if (LoadFeaturedState.Result is { } featured)
                {
                    @foreach (var species in featured)
                    {
                        <SpeciesCard @key="species.Id" Species="@species" OnClick="NavigateToSpecies" />
                    }
                }
                else
                {
                    @for (var i = 0; i < FeaturedSkeletonCount; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="280px" Class="rounded-lg" />
                    }
                }
            </FfShelf>
        }

        @* --- Taxa --------------------------------------------------------- *@
        @if (LoadTaxaState.Result is not { Count: 0 })
        {
            <FfShelf Title="@L[HomeTaxaHeading]"
                     Subtitle="@L[HomeTaxaSub]"
                     ActionLabel="@L[HomeShowAll]"
                     ActionHref="/categories">
                @if (LoadTaxaState.Result is { } taxa)
                {
                    @foreach (var (taxon, index) in taxa.Select((t, i) => (t, i)))
                    {
                        <FfTaxonCard @key="taxon.Code"
                                     Label="@L[TaxonIcons.GetLabelKey(taxon.Code)]"
                                     IconClass="@TaxonIcons.GetIcon(taxon.Code)"
                                     Meta="@TaxonMeta(taxon.Count)"
                                     Href="/categories"
                                     Tone="@(index % TonePalette)" />
                    }
                }
                else
                {
                    @for (var i = 0; i < TileSkeletonCount; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="112px" Class="rounded-lg" />
                    }
                }
            </FfShelf>
        }

        @* --- Municipios --------------------------------------------------- *@
        @if (LoadTopMunicipiosState.Result is not { Count: 0 })
        {
            <FfShelf Title="@L[HomeMunicipiosHeading]"
                     Subtitle="@L[HomeMunicipiosSub]"
                     ActionLabel="@L[HomeShowAll]"
                     ActionHref="/municipalities">
                @if (LoadTopMunicipiosState.Result is { } municipios)
                {
                    @foreach (var (municipio, index) in municipios.Select((m, i) => (m, i)))
                    {
                        <FfTaxonCard @key="municipio.Id"
                                     Label="@municipio.Name"
                                     IconClass="fa-solid fa-mountain-sun"
                                     Meta="@MunicipioMeta(municipio.Count)"
                                     Href="@($"/municipalities/{municipio.Id}")"
                                     Tone="@(index % TonePalette)" />
                    }
                }
                else
                {
                    @for (var i = 0; i < TileSkeletonCount; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="112px" Class="rounded-lg" />
                    }
                }
            </FfShelf>
        }
    }
</div>

@code {
    // Keys held as consts so they can appear in Razor attribute forms
    // (`Title="@L[SomeKey]"`) without tripping the nested-quote rule.
    private const string HomeQuickMap = "Home_Quick_Map";
    private const string HomeQuickSpecies = "Home_Quick_Species";
    private const string HomeQuickEndemic = "Home_Quick_Endemic";
    private const string HomeQuickThreatened = "Home_Quick_Threatened";
    private const string HomeFeaturedHeading = "Home_Featured_Heading";
    private const string HomeFeaturedSub = "Home_Featured_Sub";
    private const string HomeTaxaHeading = "Home_Taxa_Heading";
    private const string HomeTaxaSub = "Home_Taxa_Sub";
    private const string HomeMunicipiosHeading = "Home_Municipios_Heading";
    private const string HomeMunicipiosSub = "Home_Municipios_Sub";
    private const string HomeShowAll = "Home_ShowAll";
    private const string HomeEmptyTitle = "Home_Empty_Title";
    private const string HomeEmptyDescription = "Home_Empty_Description";
    private const string HomeLoadError = "Home_LoadError";

    private const int TopMunicipioCount = 8;
    private const int FeaturedSkeletonCount = 4;
    private const int TileSkeletonCount = 8;
    private const int TonePalette = 8;

    private string? _statsLoadError;
    private string? _featuredLoadError;
    private string? _taxaLoadError;
    private string? _municipiosLoadError;

    private string Greeting => DateTimeOffset.Now.Hour switch
    {
        < 12 => L["Home_Greeting_Morning"],
        < 19 => L["Home_Greeting_Afternoon"],
        _ => L["Home_Greeting_Evening"]
    };

    private string GreetingSubline => LoadStatsState.Result is { } stats
        ? L["Home_Greeting_Sub", stats.TotalSpecies, stats.MunicipalitiesCovered]
        : L["Home_Greeting_Sub_Loading"];

    // One alert for the page — a shelf that failed simply doesn't render.
    private string? LoadError =>
        _statsLoadError ?? _featuredLoadError ?? _taxaLoadError ?? _municipiosLoadError;

    // Only once every shelf has answered and none of them has anything.
    private bool NothingToShow =>
        LoadFeaturedState.Result is { Count: 0 } &&
        LoadTaxaState.Result is { Count: 0 } &&
        LoadTopMunicipiosState.Result is { Count: 0 };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        L.LanguageChanged += OnLanguageChanged;
    }

    [Command, RunOnLoad]
    private async Task<SpeciesStatsDto?> LoadStats(CancellationToken ct)
    {
        var result = await SpeciesClient.GetStatsAsync(ct);
        if (!result.TryPickT0(out var stats, out var error))
        {
            _statsLoadError = ErrorMessage(error);
            return null;
        }

        _statsLoadError = null;
        return stats;
    }

    [Command, RunOnLoad]
    private async Task<IReadOnlyList<SpeciesDtoForList>?> LoadFeatured(CancellationToken ct)
    {
        var result = await SpeciesClient.GetFeaturedAsync(ct);
        if (!result.TryPickT0(out var featured, out var error))
        {
            _featuredLoadError = ErrorMessage(error);
            return [];
        }

        _featuredLoadError = null;
        return featured;
    }

    [Command, RunOnLoad]
    private async Task<IReadOnlyList<TaxonFacetDto>?> LoadTaxa(CancellationToken ct)
    {
        var result = await SpeciesCategoryClient.GetCountsAsync(ct);
        if (!result.TryPickT0(out var counts, out var error))
        {
            _taxaLoadError = ErrorMessage(error);
            return [];
        }

        _taxaLoadError = null;
        return counts;
    }

    [Command, RunOnLoad]
    private async Task<IReadOnlyList<MunicipioTile>?> LoadTopMunicipios(CancellationToken ct)
    {
        // Run the list stream + count fetch in parallel; the names live on one
        // side of the join and the tallies on the other.
        var countsTask = SpeciesClient.GetCountsByMunicipalityAsync(ct);

        var collected = new List<MunicipalityDtoForList>();
        try
        {
            await foreach (var municipality in MunicipalityClient.GetMunicipalitiesAsync(
                               new MunicipalityParameters(PageSize: 200, StateCode: "PR"),
                               ct))
            {
                collected.Add(municipality);
            }
        }
        catch (HttpRequestException)
        {
            // The list stream has no error channel — the transport exception is the signal.
            _municipiosLoadError = L[HomeLoadError];
            return [];
        }

        var countsResult = await countsTask;
        if (!countsResult.TryPickT0(out var counts, out var countsError))
        {
            _municipiosLoadError = ErrorMessage(countsError);
            return [];
        }

        _municipiosLoadError = null;

        var namesById = collected.ToDictionary(m => m.Id, m => m.Name);
        return counts
            .Where(c => c.Count > 0 && namesById.ContainsKey(c.MunicipalityId))
            .OrderByDescending(c => c.Count)
            .Take(TopMunicipioCount)
            .Select(c => new MunicipioTile(c.MunicipalityId, namesById[c.MunicipalityId], c.Count))
            .ToList();
    }

    private string ErrorMessage(RequestFailed error) =>
        error.StatusCode == 0 ? L[HomeLoadError] : error.Message ?? L[HomeLoadError];

    private string TaxonMeta(int count) => L["Home_TaxonCount", count];

    private string MunicipioMeta(int count) => L["Home_MunicipioCount", count];

    private void NavigateToSpecies(SpeciesDtoForList species) =>
        NavigationManager.NavigateTo($"/species/{species.Id}");

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
        base.Dispose();
    }

    private sealed record MunicipioTile(Guid Id, string Name, int Count);
}
