@namespace FaunaFinder.Client.Components.Species
@using EcoData.Wildlife.Contracts
@using EcoData.Wildlife.Contracts.Dtos
@using EcoData.Wildlife.Contracts.Parameters
@using EcoData.Wildlife.Application.Client
@using EcoData.NativeUi.Components.VirtualizedList
@implements IAsyncDisposable
@inject ISpeciesHttpClient SpeciesClient
@inject IBrowserViewportService Viewport
@inject ILocalizer L

<NuiVirtualizedGrid @ref="_grid"
                    TItem="SpeciesDtoForList"
                    TParams="SpeciesParameters"
                    ItemsProvider="Fetch"
                    ParametersBuilder="BuildParameters"
                    CursorSelector="@(s => s.Id)"
                    ItemSize="@_rowHeight"
                    OverscanCount="2"
                    Columns="@_columns"
                    GridClass="ff-grid">
    <LoadingTemplate>
        <div class="ff-grid">
            @for (var i = 0; i < 8; i++)
            {
                <div class="ff-grid-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="ff-grid-skeleton-img" />
                    <div class="ff-grid-skeleton-body">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" />
                    </div>
                </div>
            }
        </div>
    </LoadingTemplate>
    <EmptyTemplate>
        <NuiEmptyState Icon="@Icons.Material.Outlined.SearchOff"
                       Title="@L[EmptyTitleKey]"
                       Description="@L[EmptyDescriptionKey]" />
    </EmptyTemplate>
    <ErrorTemplate Context="error">
        <NuiEmptyState Icon="@Icons.Material.Outlined.CloudOff"
                       Title="@L[error.StatusCode is null or 0 ? UnreachableKey : LoadFailedKey]" />
    </ErrorTemplate>
    <ItemTemplate Context="species">
        <SpeciesCard Species="species" OnClick="HandleClick" />
    </ItemTemplate>
    <PlaceholderTemplate>
        <div class="ff-grid-skeleton">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="ff-grid-skeleton-img" />
            <div class="ff-grid-skeleton-body">
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" />
            </div>
        </div>
    </PlaceholderTemplate>
</NuiVirtualizedGrid>

@code {
    private const int PageSize = 24;
    private const string UnreachableKey = "Species_Grid_Error_Unreachable";
    private const string LoadFailedKey = "Species_Grid_Error_Generic";

    [Parameter] public SpeciesFilterResult Filter { get; set; } = SpeciesFilterResult.Empty;
    [Parameter] public string? Search { get; set; }
    [Parameter] public SpeciesSort Sort { get; set; } = SpeciesSort.ScientificNameAsc;
    [Parameter] public Guid? MunicipalityId { get; set; }
    [Parameter] public Guid? CategoryId { get; set; }
    [Parameter] public EventCallback<SpeciesDtoForList> OnSpeciesClick { get; set; }

    [Parameter] public string EmptyTitleKey { get; set; } = "Species_Grid_Empty_Title";
    [Parameter] public string EmptyDescriptionKey { get; set; } = "Species_Grid_Empty_Description";

    private NuiVirtualizedGrid<SpeciesDtoForList, SpeciesParameters>? _grid;

    private SpeciesFilterResult _lastFilter = SpeciesFilterResult.Empty;
    private string? _lastSearch;
    private SpeciesSort _lastSort = SpeciesSort.ScientificNameAsc;
    private Guid? _lastMunicipalityId;
    private Guid? _lastCategoryId;

    private int _columns = 4;
    private float _rowHeight = 350;
    private Guid _viewportSubscriptionId;

    protected override async Task OnInitializedAsync()
    {
        L.LanguageChanged += OnLanguageChanged;
        ApplyBreakpoint(await Viewport.GetCurrentBreakpointAsync());
        _viewportSubscriptionId = Guid.NewGuid();
        await Viewport.SubscribeAsync(_viewportSubscriptionId, OnBreakpointChanged);
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private Task OnBreakpointChanged(BrowserViewportEventArgs args)
    {
        var prevCols = _columns;
        var prevRow = _rowHeight;
        ApplyBreakpoint(args.Breakpoint);
        if (prevCols == _columns && Math.Abs(prevRow - _rowHeight) < 0.5f)
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(() =>
        {
            StateHasChanged();
            _grid?.Refresh(); // row geometry changed — Virtualize needs fresh math
        });
    }

    private void ApplyBreakpoint(Breakpoint breakpoint)
    {
        (_columns, _rowHeight) = breakpoint switch
        {
            Breakpoint.Xs => (1, 420f),
            Breakpoint.Sm => (2, 440f),
            Breakpoint.Md => (3, 400f),
            _ => (4, 350f),
        };
    }

    protected override void OnParametersSet()
    {
        if (_grid is null)
        {
            // Pre-render pass: the grid's own initial load uses these values, so
            // bank them here or the first re-render reads as a change.
            _lastFilter = Filter;
            _lastSearch = Search;
            _lastSort = Sort;
            _lastMunicipalityId = MunicipalityId;
            _lastCategoryId = CategoryId;
            return;
        }

        var filterChanged = _lastFilter != Filter;
        var searchChanged = !string.Equals(_lastSearch, Search, StringComparison.Ordinal);
        var sortChanged = _lastSort != Sort;
        var scopeChanged = _lastMunicipalityId != MunicipalityId || _lastCategoryId != CategoryId;

        if (filterChanged || searchChanged || sortChanged || scopeChanged)
        {
            _lastFilter = Filter;
            _lastSearch = Search;
            _lastSort = Sort;
            _lastMunicipalityId = MunicipalityId;
            _lastCategoryId = CategoryId;
            _grid.Refresh();
        }
    }

    public async ValueTask DisposeAsync()
    {
        L.LanguageChanged -= OnLanguageChanged;
        if (_viewportSubscriptionId != Guid.Empty)
        {
            await Viewport.UnsubscribeAsync(_viewportSubscriptionId);
        }
    }

    private SpeciesParameters BuildParameters(Guid? cursor) => new(
        PageSize: PageSize,
        Cursor: cursor,
        Search: string.IsNullOrWhiteSpace(Search) ? null : Search,
        CategoryId: CategoryId,
        MunicipalityId: MunicipalityId,
        EndemicStatuses: Filter.EndemicOnly ? [EndemicStatus.Endemic] : null,
        HasProfileImage: Filter.HasPhoto ? true : null,
        IucnStatuses: Filter.IucnStatuses.Count > 0 ? Filter.IucnStatuses.ToArray() : null,
        TaxonCodes: Filter.TaxonCodes.Count > 0 ? Filter.TaxonCodes.ToArray() : null,
        MinMunicipalityCount: Filter.MinMunicipalityCount,
        ObservedSinceUtc: Filter.ObservedRecently
            ? DateTimeOffset.UtcNow.AddYears(-1)
            : null,
        Sort: Sort
    );

    private IAsyncEnumerable<SpeciesDtoForList> Fetch(SpeciesParameters parameters, CancellationToken ct) =>
        SpeciesClient.GetSpeciesAsync(parameters, ct);

    private Task HandleClick(SpeciesDtoForList species) =>
        OnSpeciesClick.InvokeAsync(species);
}
