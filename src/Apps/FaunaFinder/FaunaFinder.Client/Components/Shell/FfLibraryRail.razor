@namespace FaunaFinder.Client.Components.Shell
@inherits EcoDataComponent

<aside class="ff-rail">
    <h2 class="ff-rail-heading">@L["Rail_Heading"]</h2>

    <nav class="ff-rail-cards" aria-label="@L["Rail_Heading"]">
        <a href="/coordinates" class="ff-rail-card">
            <MudIcon Icon="@Icons.Material.Outlined.PinDrop" Class="ff-rail-card-icon" />
            <span class="ff-rail-card-text">
                <span class="ff-rail-card-title">@L["Rail_Card_Coordinates"]</span>
                <span class="ff-rail-card-desc">@L["Rail_Card_Coordinates_Lede"]</span>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="ff-rail-card-chevron" />
        </a>
    </nav>
</aside>
