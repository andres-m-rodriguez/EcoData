@namespace FaunaFinder.Client.Components.Shell
@inherits LocalizedComponentBase
@using EcoData.Locations.Contracts.Dtos
@using EcoData.Wildlife.Contracts.Dtos
@inject ISpeciesHttpClient SpeciesClient
@inject IMunicipalityHttpClient MunicipalityClient
@inject NavigationManager Navigation

@* The app bar's search. Takes no parameters — the layout renders it bare, the
   same way it renders the notebook rail.

   Two independent fetches (species, municipios) feed one dropdown. Neither is
   a [RunOnLoad]: nothing is asked of the server until the reader has typed two
   characters, and a null command result is the only loading sentinel kept.

   Search is chrome. A transport failure returns an empty list rather than an
   alert, so a dead network reads exactly like a genuine no-match. *@

<div class="ff-search" @onkeydown="HandleKeyDown" @onfocusin="HandleFocusIn">
    @* The resting capsule, carried over from the layout's placeholder pill. *@
    <div class="ff-search-pill">
        <MudIcon Icon="@Icons.Material.Filled.Search" Class="ff-search-glyph" />

        @* Immediate + a 300ms debounce is the house convention — see NuiSearchBar. *@
        <MudTextField T="string"
                      Value="@_query"
                      ValueChanged="HandleQueryChanged"
                      Placeholder="@L[SearchPlaceholderKey]"
                      Variant="Variant.Text"
                      Margin="Margin.None"
                      Underline="false"
                      Immediate="true"
                      DebounceInterval="300"
                      Class="ff-search-input" />

        @if (HasText)
        {
            <button type="button"
                    class="ff-search-clear"
                    aria-label="@L[ClearLabelKey]"
                    @onclick="Clear">
                <MudIcon Icon="@Icons.Material.Filled.Close" />
            </button>
        }
    </div>

    @if (IsPanelOpen)
    {
        <div class="ff-search-panel">
            @if (IsPending)
            {
                <p class="ff-search-note">@L["Shell_Search_Searching"]</p>
            }
            else if (ShowEmpty)
            {
                @* Failed and empty read the same — the bar never shouts. *@
                <p class="ff-search-note">@L["Shell_Search_Empty", Query]</p>
            }
            else
            {
                @if (SpeciesResults is { Count: > 0 } species)
                {
                    <p class="ff-search-group">@L["Nav_Species"]</p>
                    @foreach (var match in species)
                    {
                        @* Names are stored per-locale; resolving goes through the
                           shell's cascading context, same as the rail. *@
                        var commonName = Locale.Resolve(match.CommonName, fallback: match.ScientificName);
                        <a class="ff-search-item"
                           href="@SpeciesHref(match.Id)"
                           @key="match.Id"
                           @onclick="Close">
                            @if (match.HasProfileImage)
                            {
                                <img class="ff-search-art ff-search-art--photo"
                                     src="@SpeciesImageSrc(match.Id)"
                                     alt=""
                                     loading="lazy" />
                            }
                            else
                            {
                                <span class="ff-search-art ff-search-art--species">
                                    <i class="@TaxonIcons.GetIcon(match.TaxonCode)" aria-hidden="true"></i>
                                </span>
                            }
                            <span class="ff-search-body">
                                <span class="ff-search-name">@commonName</span>
                                <span class="ff-search-sci">@match.ScientificName</span>
                            </span>
                        </a>
                    }
                }

                @if (MunicipalityResults is { Count: > 0 } municipios)
                {
                    <p class="ff-search-group">@L["Nav_Municipios"]</p>
                    @foreach (var municipio in municipios)
                    {
                        <a class="ff-search-item"
                           href="@MunicipalityHref(municipio.Id)"
                           @key="municipio.Id"
                           @onclick="Close">
                            <span class="ff-search-art ff-search-art--place">
                                <i class="fa-solid fa-mountain-sun" aria-hidden="true"></i>
                            </span>
                            <span class="ff-search-body">
                                <span class="ff-search-name">@municipio.Name</span>
                            </span>
                        </a>
                    }
                }
            }
        </div>
    }

    @* Outside-click catcher, the way the sibling Harmony app does it. Sits
       under the panel and over everything else this component draws. *@
    <MudOverlay Visible="@IsPanelOpen" OnClick="Close" />
</div>
