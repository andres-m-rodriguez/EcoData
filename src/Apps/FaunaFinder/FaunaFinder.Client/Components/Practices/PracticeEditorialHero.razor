@namespace FaunaFinder.Client.Components.Practices
@inherits EcoDataComponent

<section class="pp-hero">
    <div class="pp-hero-main">
        <div class="pp-hero-eyebrow">@EyebrowText</div>
        <h1 class="pp-hero-heading">
            @L["Practices_Hero_HeadingLead"] <em>Puerto Rico</em>@L["Practices_Hero_HeadingTail"]
        </h1>
        <p class="pp-hero-lede">@LedeText</p>
    </div>
    <div class="pp-hero-meta">
        <span>@L["Hero_LastSync", LastSync]</span>
        <span>@RecordsLine</span>
        <span>@L["Practices_Hero_Hint"]</span>
    </div>
</section>

@code {
    [Parameter] public int? PracticeCount { get; set; }

    [Parameter] public string? Eyebrow { get; set; }

    [Parameter] public string? Lede { get; set; }

    private string EyebrowText => Eyebrow ?? L["Hero_Eyebrow"];
    private string LedeText => Lede ?? L["Practices_Hero_Lede"];

    private string LastSync => DateTime.Now.ToString("HH:mm") + " local";

    private string RecordsLine => PracticeCount is { } count
        ? L["Practices_Hero_RecordsLine", count]
        : L["Practices_Hero_RecordsPending"];
}
