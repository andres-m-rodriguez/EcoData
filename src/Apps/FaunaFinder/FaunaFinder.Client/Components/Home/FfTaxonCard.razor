@namespace FaunaFinder.Client.Components.Home

@* Circular duotone taxon tile. Label and Meta arrive pre-translated. *@

<a class="ff-taxon-card" href="@Href">
    <span class="ff-taxon-art @ToneClass">
        <i class="@IconClass"></i>
    </span>

    <span class="ff-taxon-label">@Label</span>

    @if (!string.IsNullOrWhiteSpace(Meta))
    {
        <span class="ff-taxon-meta">@Meta</span>
    }
</a>

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }

    [Parameter, EditorRequired] public required string IconClass { get; set; }

    [Parameter] public string? Meta { get; set; }

    [Parameter, EditorRequired] public required string Href { get; set; }

    [Parameter] public int Tone { get; set; }

    private string ToneClass => $"tone-{((Tone % 8) + 8) % 8}";
}
