@namespace FaunaFinder.Client.Components.Home

@* Titled horizontal shelf. All copy arrives pre-translated via parameters —
   this component is deliberately localization-free. *@

<section class="ff-shelf">
    <div class="ff-shelf-head">
        <div class="ff-shelf-heading">
            <h2 class="ff-shelf-title">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="ff-shelf-sub">@Subtitle</p>
            }
        </div>

        @if (HasAction)
        {
            <a class="ff-shelf-action" href="@ActionHref">@ActionLabel</a>
        }
    </div>

    <div class="ff-shelf-row">@ChildContent</div>
</section>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? ActionLabel { get; set; }

    [Parameter] public string? ActionHref { get; set; }

    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }

    private bool HasAction =>
        !string.IsNullOrWhiteSpace(ActionLabel) && !string.IsNullOrWhiteSpace(ActionHref);
}
