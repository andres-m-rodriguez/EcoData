@using EcoData.Common.i18n
@inherits LayoutComponentBase
@inject INativeNavigationManager Navigation
@inject INativeNavbarManager Navbar
@inject ILocalizer L
@implements IDisposable

<MudThemeProvider Theme="FaunaFinderTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="_locale" IsFixed="false">
    @* .ff-shell is the cream ground every panel floats in. It is also the only
       plain element wrapping MudLayout/MudAppBar/MudMainContent, so it is what
       carries Blazor's scope attribute — every ::deep rule in the companion
       stylesheet resolves through it. *@
    <div class="ff-shell">
        <MudLayout>
            <MudAppBar Elevation="0" Fixed="true" Class="ff-appbar">
                @* Mobile: Back button + Title OR Logo *@
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <div class="d-flex align-center appbar-mobile-lead">
                        @if (!IsRootPage)
                        {
                            <NuiNativeNavbar ShowBackButton="true" ShowTitle="false" ShowActions="false" />
                            <span class="page-title">@Navbar.State.Title</span>
                        }
                        else
                        {
                            <span class="logo-text">FaunaFinder</span>
                        }
                    </div>
                </MudHidden>

                @* Desktop: Logo + Page Title *@
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <div class="d-flex align-center">
                        <span class="logo-text">FaunaFinder</span>
                        @if (ShowTitleDivider)
                        {
                            <MudDivider Vertical="true" FlexItem="true" Class="mx-4 my-3" />
                            <span class="page-title">@Navbar.State.Title</span>
                        }
                    </div>
                </MudHidden>

                @* Desktop: Navigation links *@
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <nav class="ff-nav ml-6">
                        <a href="/" class="@GetNavLinkClass("/", exact: true)">@L["Nav_Home"]</a>
                        <a href="/map" class="@GetNavLinkClass("/map")">@L["Nav_Map"]</a>
                        <a href="/species" class="@GetNavLinkClass("/species")">@L["Nav_Species"]</a>
                        <a href="/municipalities" class="@GetNavLinkClass("/municipalities")">@L["Nav_Municipios"]</a>
                        <a href="/categories" class="@GetNavLinkClass("/categories")">@L["Nav_Categories"]</a>
                        <a href="/practices" class="@GetNavLinkClass("/practices")">@L["Nav_Practices"]</a>
                        <a href="/actions" class="@GetNavLinkClass("/actions")">@L["Nav_Actions"]</a>
                    </nav>
                </MudHidden>

                <MudSpacer />

                @* Desktop: search affordance. Presentation only for now — no input,
                   no binding, no handler. It reserves the slot the real search will
                   take and gives the bar its Harmony-side weight. *@
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <div class="ff-search-pill">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                        <span class="ff-search-pill-text">@L["Shell_Search"]</span>
                    </div>
                </MudHidden>

                @* Language dropdown — MudMenu using its built-in activator
                   (Label + StartIcon + EndIcon) instead of ActivatorContent.
                   The Activator-content route wouldn't open inside MudAppBar;
                   built-in mode uses MudBlazor's tested internal wiring. *@
                <MudMenu Label="@L.CurrentLanguage.ToUpperInvariant()"
                         StartIcon="@Icons.Material.Filled.Language"
                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                         Variant="Variant.Text"
                         Color="Color.Inherit"
                         Size="Size.Small"
                         AriaLabel="Language"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Class="ff-lang-menu">
                    @foreach (var lang in L.GetAvailableLanguages())
                    {
                        var langCode = lang.Code;
                        var isActive = string.Equals(langCode, L.CurrentLanguage, StringComparison.OrdinalIgnoreCase);
                        <MudMenuItem OnClick="@(() => L.SetLanguage(langCode))">
                            <div class="@(isActive ? "ff-lang-item is-active" : "ff-lang-item")">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                <span class="ff-lang-item-name">@lang.Name</span>
                                <span class="ff-lang-item-code">@langCode.ToUpperInvariant()</span>
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>

                @* Mobile: Action button(s) at far right *@
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    @if (!IsRootPage)
                    {
                        <NuiNativeNavbar ShowBackButton="false" ShowTitle="false" />
                    }
                </MudHidden>
            </MudAppBar>

            <MudMainContent Class="main-content">
                <div class="ff-shell-body">
                    @* Library rail — desktop only, and never on the map, which
                       claims the full width for the viewport. *@
                    @if (ShowLibraryRail)
                    {
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <aside class="ff-rail-panel">
                                <FfLibraryRail />
                            </aside>
                        </MudHidden>
                    }

                    <div class="ff-main-panel">
                        @if (IsFullBleedPage)
                        {
                            @Body
                        }
                        else
                        {
                            <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 px-4">
                                @Body
                            </MudContainer>
                        }
                    </div>
                </div>
            </MudMainContent>
        </MudLayout>

        @* Mobile Bottom Navigation - Outside MudLayout for stability *@
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <div class="bottom-nav">
                <MudStack Row="true" Justify="Justify.SpaceAround" AlignItems="AlignItems.Center" Class="bottom-nav-container">
                    <MudButton Variant="Variant.Text" Color="@GetBottomNavColor(NavigationTab.Home)" Class="@GetBottomNavClass(NavigationTab.Home)"
                               OnClick="@(() => NavigateToTab(NavigationTab.Home))">
                        <MudStack AlignItems="AlignItems.Center" Spacing="0">
                            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@L["Nav_Home"]</MudText>
                        </MudStack>
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="@GetBottomNavColor(NavigationTab.Map)" Class="@GetBottomNavClass(NavigationTab.Map)"
                               OnClick="@(() => NavigateToTab(NavigationTab.Map))">
                        <MudStack AlignItems="AlignItems.Center" Spacing="0">
                            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@L["Nav_Map"]</MudText>
                        </MudStack>
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="@GetBottomNavColor(NavigationTab.Species)" Class="@GetBottomNavClass(NavigationTab.Species)"
                               OnClick="@(() => NavigateToTab(NavigationTab.Species))">
                        <MudStack AlignItems="AlignItems.Center" Spacing="0">
                            <MudIcon Icon="@Icons.Material.Filled.Pets" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@L["Nav_Species"]</MudText>
                        </MudStack>
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="@GetBottomNavColor(NavigationTab.Municipalities)" Class="@GetBottomNavClass(NavigationTab.Municipalities)"
                               OnClick="@(() => NavigateToTab(NavigationTab.Municipalities))">
                        <MudStack AlignItems="AlignItems.Center" Spacing="0">
                            <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@L["Nav_Municipios"]</MudText>
                        </MudStack>
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="@GetBottomNavColor(NavigationTab.Categories)" Class="@GetBottomNavClass(NavigationTab.Categories)"
                               OnClick="@(() => NavigateToTab(NavigationTab.Categories))">
                        <MudStack AlignItems="AlignItems.Center" Spacing="0">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@L["Nav_Categories"]</MudText>
                        </MudStack>
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="@GetBottomNavColor(NavigationTab.Practices)" Class="@GetBottomNavClass(NavigationTab.Practices)"
                               OnClick="@(() => NavigateToTab(NavigationTab.Practices))">
                        <MudStack AlignItems="AlignItems.Center" Spacing="0">
                            <MudIcon Icon="@Icons.Material.Filled.Agriculture" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@L["Nav_Practices"]</MudText>
                        </MudStack>
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="@GetBottomNavColor(NavigationTab.Actions)" Class="@GetBottomNavClass(NavigationTab.Actions)"
                               OnClick="@(() => NavigateToTab(NavigationTab.Actions))">
                        <MudStack AlignItems="AlignItems.Center" Spacing="0">
                            <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@L["Nav_Actions"]</MudText>
                        </MudStack>
                    </MudButton>
                </MudStack>
            </div>
        </MudHidden>
    </div>
</CascadingValue>

@code {
    private enum NavigationTab { Home, Map, Species, Municipalities, Categories, Practices, Actions }

    private NavigationTab _currentTab = NavigationTab.Home;
    private LocaleContext _locale = LocaleContext.English;

    // Root ("/") only — decides logo vs. back button in the mobile app bar.
    private bool IsRootPage => Navigation.State.Path == "/" || Navigation.State.Path == "";

    private bool IsMapPage =>
        Navigation.State.Path.StartsWith("/map", StringComparison.OrdinalIgnoreCase);

    private bool IsEditorialListPage =>
        string.Equals(Navigation.State.Path, "/species", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/municipalities", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/categories", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/practices", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/actions", StringComparison.OrdinalIgnoreCase);

    // Pages that draw their own page chrome: the editorial home, the full-screen
    // map, and the top-level list pages. They get @Body with no MudContainer.
    private bool IsFullBleedPage => IsRootPage || IsMapPage || IsEditorialListPage;

    // Hide the divider+title on top-level pages (home, map, species, muni, categories).
    // Each either renders its own root heading or relies on the active nav pill for context.
    private bool ShowTitleDivider =>
        !IsRootPage && !IsMapPage && !IsEditorialListPage && Navbar.State.Title is not null;

    // The rail is a desktop companion column. The map is the one page that
    // wants the whole ground, so it never gets one.
    private bool ShowLibraryRail => !IsMapPage;

    protected override void OnInitialized()
    {
        Navigation.OnStateChanged += HandleNavigationStateChanged;
        Navbar.OnStateChanged += HandleNavbarStateChanged;
        L.LanguageChanged += HandleLanguageChanged;
        _locale = L.CurrentLanguage == "es" ? LocaleContext.Spanish : LocaleContext.English;
        UpdateCurrentTab();
    }

    private void HandleNavigationStateChanged()
    {
        UpdateCurrentTab();
        InvokeAsync(StateHasChanged);
    }

    private void HandleNavbarStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLanguageChanged()
    {
        _locale = L.CurrentLanguage == "es" ? LocaleContext.Spanish : LocaleContext.English;
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentTab()
    {
        var path = Navigation.State.Path;
        _currentTab = path switch
        {
            "/" or "" => NavigationTab.Home,
            var p when p.StartsWith("/map", StringComparison.OrdinalIgnoreCase) => NavigationTab.Map,
            var p when p.StartsWith("/species", StringComparison.OrdinalIgnoreCase) => NavigationTab.Species,
            var p when p.StartsWith("/municipalities", StringComparison.OrdinalIgnoreCase) => NavigationTab.Municipalities,
            var p when p.StartsWith("/categories", StringComparison.OrdinalIgnoreCase) => NavigationTab.Categories,
            var p when p.StartsWith("/practices", StringComparison.OrdinalIgnoreCase) => NavigationTab.Practices,
            var p when p.StartsWith("/actions", StringComparison.OrdinalIgnoreCase) => NavigationTab.Actions,
            _ => NavigationTab.Home
        };
    }

    private string GetNavLinkClass(string path, bool exact = false)
    {
        var currentPath = Navigation.State.Path;
        var isActive = exact
            ? (path == "/" ? currentPath == "/" || string.IsNullOrEmpty(currentPath) : string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase))
            : currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);

        return isActive ? "ff-nav-link is-active" : "ff-nav-link";
    }

    private Color GetBottomNavColor(NavigationTab tab)
    {
        return _currentTab == tab ? Color.Primary : Color.Default;
    }

    // The active tab reads as a filled pine chip, which MudBlazor's Color
    // parameter can't express on a text button — the class carries the fill.
    private string GetBottomNavClass(NavigationTab tab)
    {
        return _currentTab == tab ? "bottom-nav-item is-active" : "bottom-nav-item";
    }

    private void NavigateToTab(NavigationTab tab)
    {
        var path = tab switch
        {
            NavigationTab.Home => "/",
            NavigationTab.Map => "/map",
            NavigationTab.Species => "/species",
            NavigationTab.Municipalities => "/municipalities",
            NavigationTab.Categories => "/categories",
            NavigationTab.Practices => "/practices",
            NavigationTab.Actions => "/actions",
            _ => "/"
        };
        Navigation.NavigateTo(path);
    }

    private void SetLocale(string code) => L.SetLanguage(code);

    public void Dispose()
    {
        Navigation.OnStateChanged -= HandleNavigationStateChanged;
        Navbar.OnStateChanged -= HandleNavbarStateChanged;
        L.LanguageChanged -= HandleLanguageChanged;
    }
}
