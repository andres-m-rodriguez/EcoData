@using EcoData.Common.i18n
@using FaunaFinder.Client.Services.Account
@inherits EcoDataLayout
@inject INavigationManager Navigation
@inject INavbarManager Navbar
@inject IJavascriptSafeInterop JS
@inject AuthStateService Auth

<MudThemeProvider Theme="FaunaFinderTheme.Default" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="_locale" IsFixed="false">
    <div class="@ShellClass">
        <MudLayout>
            <MudAppBar Elevation="0" Fixed="true" Class="ff-appbar">
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <FfMobileTitle />
                </MudHidden>

                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <div class="d-flex align-center">
                        @if (ShowLibraryRail)
                        {
                            <MudTooltip Text="@NotebookToggleLabel">
                                <MudIconButton Icon="@NotebookToggleIcon"
                                               Class="ff-notebook-toggle"
                                               Edge="Edge.Start"
                                               aria-label="@NotebookToggleLabel"
                                               aria-expanded="@(_railOpen ? "true" : "false")"
                                               OnClick="ToggleRail"
                                               @onmouseenter="() => _railHovered = true"
                                               @onmouseleave="() => _railHovered = false" />
                            </MudTooltip>
                        }
                        <span class="logo-text">FaunaFinder</span>
                        @if (ShowTitleDivider)
                        {
                            <MudDivider Vertical="true" FlexItem="true" Class="mx-4 my-3" />
                            <span class="page-title">@Navbar.State.Title</span>
                        }
                    </div>
                </MudHidden>

                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <nav class="ff-nav ml-6">
                        <a href="/" class="@GetNavLinkClass("/", exact: true)">@L["Nav_Map"]</a>
                        <a href="/species" class="@GetNavLinkClass("/species")">@L["Nav_Species"]</a>
                        <a href="/municipalities" class="@GetNavLinkClass("/municipalities")">@L["Nav_Municipios"]</a>
                        <a href="/categories" class="@GetNavLinkClass("/categories")">@L["Nav_Categories"]</a>
                        <a href="/practices" class="@GetNavLinkClass("/practices")">@L["Nav_Practices"]</a>
                        <a href="/actions" class="@GetNavLinkClass("/actions")">@L["Nav_Actions"]</a>
                    </nav>
                </MudHidden>

                <MudSpacer />

                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <FfSearch />
                </MudHidden>

                <MudTooltip Text="@ThemeToggleLabel">
                    <MudIconButton Icon="@ThemeToggleIcon"
                                   Class="ff-theme-toggle"
                                   Size="Size.Small"
                                   aria-label="@ThemeToggleLabel"
                                   OnClick="ToggleThemeAsync" />
                </MudTooltip>

                @* Language dropdown — MudMenu using its built-in activator
                   (Label + StartIcon + EndIcon) instead of ActivatorContent.
                   The Activator-content route wouldn't open inside MudAppBar;
                   built-in mode uses MudBlazor's tested internal wiring. *@
                <MudMenu Label="@L.CurrentLanguage.ToUpperInvariant()"
                         StartIcon="@Icons.Material.Filled.Language"
                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                         Variant="Variant.Text"
                         Color="Color.Inherit"
                         Size="Size.Small"
                         AriaLabel="Language"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Class="ff-lang-menu">
                    @foreach (var lang in L.GetAvailableLanguages())
                    {
                        var langCode = lang.Code;
                        var isActive = string.Equals(langCode, L.CurrentLanguage, StringComparison.OrdinalIgnoreCase);
                        <MudMenuItem OnClick="@(() => L.SetLanguage(langCode))">
                            <div class="@(isActive ? "ff-lang-item is-active" : "ff-lang-item")">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                <span class="ff-lang-item-name">@lang.Name</span>
                                <span class="ff-lang-item-code">@langCode.ToUpperInvariant()</span>
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>

                @if (Auth.IsAuthenticated)
                {
                    <MudBadge Visible="ShowPendingBadge"
                              Dot="true"
                              Color="Color.Warning"
                              Overlap="true"
                              Class="ff-account-badge">
                        <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                                 Color="Color.Inherit"
                                 Size="Size.Small"
                                 AriaLabel="@L["Auth_AccountLabel"]"
                                 AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight"
                                 Class="ff-account-menu">
                            <div class="ff-account-header">
                                <span class="ff-account-name">@Auth.CurrentUser?.DisplayName</span>
                                <span class="ff-account-email">@Auth.CurrentUser?.Email</span>
                            </div>
                            @if (AccessRequestStatusText is { } statusText)
                            {
                                <MudDivider />
                                <div class="ff-account-status">@statusText</div>
                            }
                            <MudDivider />
                            <MudMenuItem OnClick="SignOutAsync">@L["Auth_SignOut"]</MudMenuItem>
                        </MudMenu>
                    </MudBadge>
                }
                else
                {
                    <MudTooltip Text="@L["Auth_SignIn"]">
                        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                                       Class="ff-signin-button"
                                       Size="Size.Small"
                                       Href="/login"
                                       aria-label="@L["Auth_SignIn"]" />
                    </MudTooltip>
                }

                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    @if (!IsRootPage)
                    {
                        <NuiNativeNavbar ShowBackButton="false" ShowTitle="false" />
                    }
                </MudHidden>
            </MudAppBar>

            <MudMainContent Class="main-content">
                <div class="ff-shell-body">
                    @if (ShowLibraryRail)
                    {
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <aside class="@RailPanelClass" aria-hidden="@(_railOpen ? "false" : "true")">
                                <FfLibraryRail />
                            </aside>
                        </MudHidden>
                    }

                    <div class="ff-main-panel">
                        @if (IsFullBleedPage)
                        {
                            @Body
                        }
                        else
                        {
                            <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 px-4">
                                @Body
                            </MudContainer>
                        }
                    </div>
                </div>
            </MudMainContent>
        </MudLayout>

        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <FfBottomNav />
        </MudHidden>
    </div>
</CascadingValue>

@code {
    private LocaleContext _locale = LocaleContext.English;

    private bool _railOpen = true;
    private bool _railHovered;

    private bool _isDarkMode;
    private IJSObjectReference? _themeModule;

    private bool IsRootPage => Navigation.State.Path == "/" || Navigation.State.Path == "";

    private bool IsMapPage =>
        IsRootPage || Navigation.State.Path.StartsWith("/map", StringComparison.OrdinalIgnoreCase);

    private bool IsEditorialListPage =>
        string.Equals(Navigation.State.Path, "/species", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/municipalities", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/browse", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/categories", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/practices", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Navigation.State.Path, "/actions", StringComparison.OrdinalIgnoreCase);

    private bool IsFullBleedPage => IsMapPage || IsEditorialListPage;

    private bool ShowTitleDivider =>
        !IsMapPage && !IsEditorialListPage && Navbar.State.Title is not null;

    private string RailPanelClass => _railOpen ? "ff-rail-panel" : "ff-rail-panel is-collapsed";

    private string NotebookToggleIcon => !_railHovered
        ? FaunaFinderIcons.NotebookPanel
        : _railOpen ? FaunaFinderIcons.NotebookCollapse : FaunaFinderIcons.NotebookExpand;

    private string NotebookToggleLabel => _railOpen ? L["Rail_Collapse"] : L["Rail_Expand"];

    private void ToggleRail() => _railOpen = !_railOpen;

    private string ThemeToggleIcon => _isDarkMode
        ? Icons.Material.Filled.LightMode
        : Icons.Material.Filled.DarkMode;

    private string ThemeToggleLabel => _isDarkMode ? L["Theme_ToLight"] : L["Theme_ToDark"];

    private bool ShowLibraryRail => true;

    private string ShellClass => _railOpen ? "ff-shell has-rail-open" : "ff-shell";

    private bool ShowPendingBadge => Auth.AccessRequest?.Status == "Pending";

    private string? AccessRequestStatusText => Auth.AccessRequest?.Status switch
    {
        "Pending" => L["Auth_Request_Pending"],
        "Approved" => L["Auth_Request_Approved"],
        "Rejected" => L["Auth_Request_Rejected"],
        _ => null,
    };

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/");
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _locale = L.CurrentLanguage == "es" ? LocaleContext.Spanish : LocaleContext.English;

        // Fire-and-forget: the probe publishes AuthChanged when it lands, and
        // the [Event] handler re-renders the shell with the signed-in state.
        _ = Auth.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var imported = await JS.ImportAsync("./js/fauna-theme.js");
        if (!imported.TryPickT0(out var module, out _))
        {
            return;
        }

        _themeModule = module;

        var theme = await JS.InvokeAsync<string>(module, "getTheme");
        _isDarkMode = theme.TryPickT0(out var name, out _)
            && string.Equals(name, "dark", StringComparison.OrdinalIgnoreCase);
        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        if (_themeModule is null)
        {
            return;
        }

        var next = _isDarkMode ? "light" : "dark";

        var stamped = await JS.InvokeVoidAsync(_themeModule, "setTheme", next);
        if (!stamped.IsT0)
        {
            return;
        }

        _isDarkMode = next == "dark";
    }

    private string GetNavLinkClass(string path, bool exact = false)
    {
        var currentPath = Navigation.State.Path;
        var isActive = exact
            ? (path == "/" ? currentPath == "/" || string.IsNullOrEmpty(currentPath) : string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase))
            : currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);

        return isActive ? "ff-nav-link is-active" : "ff-nav-link";
    }

    private void SetLocale(string code) => L.SetLanguage(code);
}
